{
  "name": "gordangrgic-portfolio",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "description": "Personal portfolio of Gordan Grgić: quality, testing and hardware/software work, and the MILA* audio streamer. Built on the Astro Typography theme.",
  "author": "Gordan Grgic <gordan.grgic@gmail.com> (https://github.com/Orbital1403)",
  "license": "MIT",
  "repository": "https://github.com/Orbital1403/portfolio",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "astro check && astro dev",
    "build": "npm run typecheck && astro check && astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "astro sync && tsc --noEmit",
    "build:pages": "node scripts/build-pages.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "prepare": "simple-git-hooks",
    "build:cloudflare": "node scripts/prepare-cloudflare.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.8",
    "astro-robots-txt": "^1.0.0",
    "astro-seo": "^1.2.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.7.3",
    "@iconify-json/mdi": "^1.2.3",
    "@types/node": "^22.20.5",
    "@unocss/astro": "^66.11.0",
    "@unocss/eslint-plugin": "^66.11.0",
    "@unocss/preset-attributify": "^66.11.0",
    "@unocss/reset": "^66.11.0",
    "@unocss/transformer-directives": "^66.11.0",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "1.5.0",
    "eslint-plugin-format": "1.4.0",
    "lint-staged": "^16.4.0",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.5",
    "simple-git-hooks": "^2.14.0",
    "typescript": "~5.9.3",
    "unocss": "^66.11.0",
    "unocss-preset-theme": "^0.14.1",
    "vite-plugin-devtools-json": "^1.1.2"
  },
  "simple-git-hooks": {
    "pre-commit": "npx --no-install lint-staged"
  }
}
