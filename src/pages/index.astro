---
import LayoutDefault from '~/layouts/LayoutDefault.astro'
import HobbyCards from '~/components/HobbyCards.astro'
import Icon from '~/components/Icon.astro'
import ProfilePortrait from '~/components/ProfilePortrait.astro'
---

<LayoutDefault
  title="Gordan Grgić — Quality, testing and hardware/software work"
  description="Gordan Grgić in Brussels: industrial electronics, quality control and fault analysis, brought into testing and practical projects connecting hardware and software."
>
  <div class="home-page">
    <section class="hero" aria-labelledby="home-title">
      <div class="hero-copy">
        <p class="eyebrow hero-label">GORDAN GRGIĆ / ZAGREB → BRUSSELS</p>
        <h1 id="home-title">Curiosity.<br />A practical mind.</h1>
        <p class="hero-location">I'm Gordan, originally from Zagreb. I've been living in Brussels for some time now.</p>
        <p class="hero-lead">
          Industrial electronics, quality control and fault analysis are my foundation. Today, I bring that practical
          approach to testing and projects that connect hardware and software.
        </p>
        <div class="hero-actions">
          <a class="primary-action not-underline-hover" href="#selected-work">Explore my work <Icon name="arrow" /></a>
          <a class="quiet-link" href="/contact/">Get in touch <Icon name="arrow" /></a>
        </div>
      </div>
      <figure class="hero-portrait">
        <div class="portrait-frame"><ProfilePortrait hero /></div>
        <figcaption>From Zagreb. Based in Brussels.</figcaption>
      </figure>
      <p class="hero-focus">TESTING · DIAGNOSTICS · TECHNICAL SUPPORT · INTEGRATION</p>
    </section>

    <section id="selected-work" class="home-section" aria-labelledby="work-title">
      <header class="section-header">
        <p class="eyebrow">01 / SELECTED WORK</p>
        <h2 id="work-title">Built around real problems.</h2>
        <p>Music, a garden and a shared laundry room. Three practical reasons to connect hardware and software.</p>
      </header>
      <a class="home-project main-project not-underline-hover" href="/projects/mila/">
        <div class="project-photo mila-photo">
          <img src="/images/home/mila-listening.webp" width="800" height="600" alt="MILA touch player with the DAC and linear power supply in my listening setup" loading="lazy" decoding="async" />
          <span class="photo-note">01 / HARDWARE + SOFTWARE + MUSIC</span>
        </div>
        <div class="project-copy">
          <p class="project-stage"><i aria-hidden="true"></i>Working prototype</p>
          <h3 id="home-mila-title">MILA*</h3>
          <p class="project-description">A personal audio streamer for local hi-res music, radio and streaming. Used for everyday listening, refined through testing on the real device.</p>
          <p class="project-focus">Requirements · Device testing · Releases</p>
          <span class="project-link">Explore MILA* <Icon name="arrow" /></span>
        </div>
      </a>
      <div class="supporting-projects">
        <a class="home-project not-underline-hover" href="/projects/grgagrow/">
          <div class="project-photo garden-photo">
            <img src="/images/home/grgagrow-demo.webp" width="640" height="360" alt="grgaGrow garden demo with illustrated soil sensors and simulated readings" loading="lazy" decoding="async" />
          </div>
          <div class="project-copy">
            <p class="project-stage"><i aria-hidden="true"></i>Cloud app online · Sensors next</p>
            <h3 id="home-grow-title">grgaGrow</h3>
            <p class="project-description">Soil history, weather and sun/shade in one garden app. The cloud software is online; physical sensor integration comes next.</p>
            <span class="project-link">Explore grgaGrow <Icon name="arrow" /></span>
          </div>
        </a>
        <a class="home-project not-underline-hover" href="/projects/our-laundry/">
          <div class="project-photo laundry-photo">
            <img src="/images/projects/praonica/laundry-check-phone-dog-800.webp" width="800" height="533" alt="A resident checks the laundry app on her phone before going downstairs" loading="lazy" decoding="async" />
          </div>
          <div class="project-copy">
            <p class="project-stage"><i aria-hidden="true"></i>Interactive demo · Integration in development</p>
            <h3 id="home-laundry-title">Our laundry</h3>
            <p class="project-description">Check the machines before carrying your laundry downstairs. An interactive demo, informed by initial observations from my own test appliances.</p>
            <span class="project-link">Explore Our laundry <Icon name="arrow" /></span>
          </div>
        </a>
      </div>
      <a class="section-link quiet-link" href="/projects/">All projects, including this website <Icon name="arrow" /></a>
    </section>

    <section class="home-section" aria-labelledby="experience-title">
      <header class="section-header">
        <p class="eyebrow">02 / EXPERIENCE</p>
        <h2 id="experience-title">Experience that connects.</h2>
        <p>Industrial electronics, careful measurement and practical problem solving.</p>
      </header>
      <ol class="career-timeline" role="list">
        <li>
          <div class="career-meta"><p>Oct 2006 – Dec 2011</p><span>Zagreb</span></div>
          <div class="career-copy">
            <h3>Siemens</h3><p class="career-role">Production → Quality Control</p>
            <p>Pressure and temperature transmitters. Detailed analysis of returned devices, with documentation later used for improvements within the department.</p>
            <p class="career-focus">Failure analysis · Measurement · Documentation</p>
          </div>
        </li>
        <li>
          <div class="career-meta"><p>Nov 2013 – Dec 2017</p><span>Zagreb</span></div>
          <div class="career-copy">
            <h3>Altpro</h3><p class="career-role">Quality Control &amp; Calibration</p>
            <p>Railway safety systems. Measurement, calibration and quality work in a department closely connected to development.</p>
            <p class="career-focus">Railway safety · Calibration · Testing</p>
          </div>
        </li>
        <li>
          <div class="career-meta"><p>Independent work</p><span>Brussels</span></div>
          <div class="career-copy">
            <h3>Independent technical work</h3><p class="career-role">Hands-on Technical Work</p>
            <p>Appliance repairs, installations and renovations. Learning unfamiliar tasks, diagnosing problems and making practical solutions work.</p>
            <p class="career-focus">Hardware diagnostics · Repairs · Installations</p>
          </div>
        </li>
      </ol>
      <a class="section-link quiet-link" href="/about/">Read my story <Icon name="arrow" /></a>
    </section>

    <section class="home-section" aria-labelledby="skills-title">
      <header class="section-header">
        <p class="eyebrow">03 / SKILLS &amp; LEARNING</p>
        <h2 id="skills-title">A practical foundation. Still learning.</h2>
      </header>
      <dl class="capabilities">
        <div><dt><Icon name="check" />Quality &amp; testing</dt><dd>Failure analysis, calibration, documentation and checking that a solution works.</dd></div>
        <div><dt><Icon name="chip" />Hardware &amp; systems</dt><dd>PC assembly and diagnostics. Linux, macOS, Windows and Raspberry Pi.</dd></div>
        <div><dt><Icon name="code" />Software &amp; integration</dt><dd>Completed Java studies. Python and web interfaces explored through practical projects.</dd></div>
        <div><dt><Icon name="ai" />AI &amp; Machine Learning</dt><dd>Currently studying Python, data processing and AI/ML at ITAcademy.</dd></div>
      </dl>
      <div class="education-strip">
        <div><span class="education-status">Completed</span><strong>Java Developer</strong><span>ITAcademy</span></div>
        <div><span class="education-status">In progress</span><strong>AI &amp; Machine Learning</strong><span>ITAcademy</span></div>
      </div>
      <a class="section-link quiet-link" href="/skills/">Skills &amp; course certificates <Icon name="arrow" /></a>
    </section>

    <section class="home-section" aria-labelledby="practical-title">
      <header class="section-header">
        <p class="eyebrow">04 / OTHER WORK</p>
        <h2 id="practical-title">Made with my own hands.</h2>
        <p>Different materials. The same curiosity and attention to detail.</p>
      </header>
      <HobbyCards compact />
    </section>

    <section class="contact-note" aria-labelledby="next-title">
      <div><p class="eyebrow">NEXT CHAPTER</p><h2 id="next-title">Let's put that curiosity to work.</h2><p>I'm looking for a role in testing, technical support or integration, especially where hardware meets software.</p></div>
      <a class="primary-action not-underline-hover" href="/contact/">Get in touch <Icon name="arrow" /></a>
    </section>
  </div>
</LayoutDefault>

<style>
  .home-page {
    --ink: #26333b;
    --accent: #39776c;
    --line: color-mix(in srgb, currentColor 22%, transparent);
    color: var(--ink);
    font-family: var(--body-font);
  }
  :global(html.dark) .home-page { --ink: #e7ecf3; --accent: #aed1c2; }
  p { margin: 0; }
  .eyebrow { font: 11px/1.8 var(--note-font); color: var(--note-color); letter-spacing: 1.1px; }
  .hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(175px, 225px); column-gap: 32px; align-items: center; padding: 8px 0 0; }
  .hero-copy { min-width: 0; }
  h1 { margin: 24px 0 22px; font: 400 clamp(42px, 4.8vw, 57px)/1.12 'MyFont', monospace; letter-spacing: -1px; }
  .hero-location { font-size: 16px; line-height: 1.75; color: var(--note-color); margin-bottom: 14px; }
  .hero-lead { font-size: 17px; line-height: 1.8; max-width: 48ch; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; margin-top: 26px; }
  .primary-action, .quiet-link { display: inline-flex; align-items: center; gap: 12px; font: 12px/1.7 var(--note-font); }
  .primary-action { min-height: 44px; box-sizing: border-box; padding: 12px 16px !important; background: var(--accent); color: #fff; text-decoration: none; white-space: nowrap; }
  .primary-action:hover { background: #2e6359; color: #fff; }
  :global(html.dark) .primary-action { color: #24313b; }
  :global(html.dark) .primary-action:hover { background: #c6e2d6; }
  .quiet-link { color: var(--ink); min-height: 44px; }
  .quiet-link:hover { color: var(--accent); background: transparent; }
  .hero-portrait { min-width: 0; margin: 0; align-self: center; }
  .portrait-frame { padding: 9px; border: 1px solid var(--line); background: color-mix(in srgb, var(--accent) 3%, transparent); transform: rotate(2deg); }
  .hero-portrait figcaption { margin-top: 14px; font: 10px/1.8 var(--note-font); color: var(--note-color); text-align: center; }
  .hero-focus { grid-column: 1 / -1; margin-top: 34px; padding: 16px 0; border-block: 1px solid var(--line); font: 11px/1.9 var(--note-font); letter-spacing: .7px; color: var(--note-color); }
  .home-section { margin-top: 64px; scroll-margin-top: 24px; }
  .section-header { margin-bottom: 26px; }
  .section-header h2, .contact-note h2 { margin: 12px 0 16px; font: 400 38px/1.15 'MyFont', monospace; letter-spacing: -.2px; }
  .section-header > p:last-child:not(.eyebrow) { max-width: 61ch; font-size: 16px; line-height: 1.8; color: var(--note-color); }
  .home-project { display: flex; flex-direction: column; min-width: 0; padding: 0 !important; border: 1px solid var(--line); color: var(--ink) !important; text-decoration: none; background: color-mix(in srgb, var(--accent) 2%, transparent); }
  .home-project:hover { background: color-mix(in srgb, var(--accent) 5%, transparent); border-color: var(--accent); }
  .main-project { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); }
  .project-photo { position: relative; min-width: 0; overflow: hidden; border-bottom: 1px solid var(--line); }
  .project-photo img { display: block; width: 100%; height: auto; aspect-ratio: 16/9; object-fit: cover; }
  .main-project .project-photo { display: grid; align-items: center; border-bottom: 0; border-right: 1px solid var(--line); background: #17212a; }
  .main-project .project-photo img { aspect-ratio: 4/3; }
  .photo-note { position: absolute; inset: auto 0 0; padding: 11px 14px; background: #17212a; color: #e7ecf3; font: 9px/1.7 var(--note-font); letter-spacing: .5px; }
  .project-copy { display: flex; flex-direction: column; min-width: 0; flex: 1; padding: 23px; }
  .project-stage { display: flex; align-items: baseline; gap: 7px; font: 10px/1.8 var(--note-font); color: var(--accent); }
  .project-stage i { flex: 0 0 5px; width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
  .project-copy h3 { margin: 14px 0; font: 400 35px/1.15 'MyFont', monospace; }
  .main-project h3 { font-size: 44px; }
  .project-description { margin-bottom: 16px; font-size: 15px; line-height: 1.8; }
  .project-focus { margin: 0 0 18px; font: 10px/1.9 var(--note-font); color: var(--note-color); }
  .project-link { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: auto; padding-top: 14px; border-top: 1px solid var(--line); font: 12px/1.7 var(--note-font); color: var(--accent); }
  .supporting-projects { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin-top: 20px; }
  .garden-photo img { object-fit: contain; background: #f6f5ee; }
  .laundry-photo img { object-position: center 30%; background: #f6f5ee; }
  .section-link { margin-top: 18px; }
  .career-timeline { list-style: none; margin: 0 0 0 5px; padding: 0; border-left: 1px solid var(--line); }
  .career-timeline li { position: relative; display: grid; grid-template-columns: 140px minmax(0, 1fr); gap: 24px; padding: 25px 0 25px 26px; border-bottom: 1px solid var(--line); }
  .career-timeline li::before { content: ''; position: absolute; top: 32px; left: -4px; width: 7px; height: 7px; border-radius: 50%; background: var(--accent); }
  .career-meta p, .career-meta span { display: block; font: 11px/1.8 var(--note-font); color: var(--note-color); }
  .career-meta span { margin-top: 7px; }
  .career-copy h3 { margin: 0 0 6px; font: 400 28px/1.2 'MyFont', monospace; }
  .career-copy > p:not(.career-role):not(.career-focus) { margin-top: 12px; font-size: 15px; line-height: 1.8; }
  .career-role { font: 11px/1.8 var(--note-font); color: var(--accent); }
  .career-focus { margin-top: 13px; font: 11px/1.8 var(--note-font); color: var(--note-color); }
  .capabilities { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 26px 32px; margin: 0; }
  .capabilities > div { min-width: 0; padding-top: 17px; border-top: 1px solid var(--line); }
  .capabilities dt { display: flex; align-items: center; gap: 10px; font: 500 13px/1.6 var(--note-font); }
  .capabilities dd { margin: 12px 0 0; font-size: 15px; line-height: 1.8; color: var(--note-color); }
  .education-strip { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; margin-top: 28px; padding: 22px; border: 1px solid var(--line); }
  .education-strip > div { display: flex; flex-direction: column; min-width: 0; gap: 5px; }
  .education-strip span { font: 11px/1.8 var(--note-font); color: var(--note-color); }
  .education-strip .education-status { color: var(--accent); }
  .education-strip strong { font-size: 16px; line-height: 1.6; font-weight: 500; }
  .contact-note { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px; margin-top: 60px; padding: 28px; border-block: 1px solid var(--line); background: color-mix(in srgb, var(--accent) 4%, transparent); }
  .contact-note > div { max-width: 49ch; }
  .contact-note h2 { font-size: 32px; }
  .contact-note > div > p:last-child { font-size: 16px; line-height: 1.8; }
  a:focus-visible { outline: 2px solid var(--accent); outline-offset: 5px; }
  @media (max-width: 700px) {
    .hero { grid-template-columns: minmax(0, 1fr) 88px; column-gap: 20px; align-items: center; }
    .hero-copy { display: contents; }
    .hero-label { grid-column: 1; grid-row: 1; max-width: 25ch; }
    .hero-portrait { grid-column: 2; grid-row: 1; }
    .portrait-frame { padding: 4px; }
    .hero-portrait figcaption { display: none; }
    .hero h1 { grid-column: 1 / -1; margin: 25px 0 20px; font-size: clamp(39px, 8vw, 52px); }
    .hero-location, .hero-lead, .hero-actions { grid-column: 1 / -1; }
    .hero-location { margin-bottom: 12px; }
    .hero-lead { font-size: 16px; }
    .hero-focus { margin-top: 28px; font-size: 10px; }
    .main-project { grid-template-columns: minmax(0, 1fr); }
    .main-project .project-photo { border-right: 0; border-bottom: 1px solid var(--line); }
    .main-project .project-photo img { aspect-ratio: 16/10; object-position: center 34%; }
    .supporting-projects { grid-template-columns: minmax(0, 1fr); }
    .career-timeline li { grid-template-columns: minmax(0, 1fr); gap: 12px; }
    .career-meta { display: flex; flex-wrap: wrap; gap: 6px 18px; }
    .career-meta span { margin-top: 0; }
  }
  @media (max-width: 440px) {
    .home-section { margin-top: 48px; }
    .section-header h2 { font-size: 32px; }
    .project-copy { padding: 20px; }
    .capabilities { grid-template-columns: minmax(0, 1fr); gap: 22px; }
    .education-strip { grid-template-columns: minmax(0, 1fr); gap: 20px; padding: 20px; }
    .contact-note { padding: 22px; }
  }
</style>
