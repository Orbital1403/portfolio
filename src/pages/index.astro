---
import LayoutDefault from '~/layouts/LayoutDefault.astro'
import HobbyCards from '~/components/HobbyCards.astro'
import Icon from '~/components/Icon.astro'
import SmartLawnCard from '~/components/SmartLawnCard.astro'
---

<LayoutDefault
  title="Gordan Grgić — Quality, testing and hardware/software work"
  description="Gordan Grgić, based in Brussels: quality control, failure analysis and hands-on technical work, and MILA*, a Raspberry Pi audio streamer he leads from requirements to release."
>
  <div class="notebook">
    <section class="intro">
      <p class="folio-label">PERSONAL FIELD NOTES / ZAGREB → BRUSSELS</p>
      <h1>Curiosity.<br />A practical mind.</h1>
      <p class="lead">
        I'm Gordan, from Zagreb and now based in Brussels. My background is in quality control, hardware diagnostics and
        practical technical work. I'm looking for a role in testing, technical support or integration, especially where
        hardware meets software.
      </p>
      <p class="intro-links">
        <a class="cta not-underline-hover" href="/contact/">Get in touch <Icon name="arrow" /></a><a href="/about/"
          >My story <Icon name="arrow" /></a
        >
      </p>
    </section>

    <section class="featured" aria-labelledby="streamer-title">
      <div class="section-heading">
        <span class="folio-label">01 / CURRENT PROJECT</span><span class="status"><i></i> In development</span>
      </div>
      <a class="project-image" href="/projects/"
        ><img
          src="/images/projects/gstreamer/mila-player.png"
          alt="MILA* audio streamer: current player interface and music collection"
          width="1024"
          height="600"
        /></a
      >
      <div class="project-heading">
        <h2 id="streamer-title">MILA*</h2><span class="folio-label">HARDWARE + SOFTWARE + MUSIC</span>
      </div>
      <p>
        A personal audio streamer built to be a true all-rounder: bringing together my large library of hi-res FLAC
        albums with bit-perfect delivery, internet radio and streaming — in one responsive place shaped around how I
        actually listen.
      </p>
      <div class="project-specs">
        <span>Raspberry Pi 5</span><span>Hi-Res FLAC</span><span>USB DAC</span><span>10″ touch display</span><span
          >All-rounder</span
        >
      </div>
      <a class="text-action" href="/projects/">Open the project notes <Icon name="arrow" /></a>
    </section>

    <SmartLawnCard />

    <section class="experience" aria-labelledby="experience-title">
      <div class="section-heading"><span class="folio-label">02 / EXPERIENCE</span></div>
      <h2 id="experience-title">Experience that connects.</h2>

      <div class="experience-entry">
        <span class="entry-index">A</span>
        <div>
          <div class="entry-top">
            <h3>Siemens</h3>
            <span class="entry-loc">Production · Zagreb · Oct 2006 – Dec 2011</span>
          </div>
          <p class="entry-role">Production → Quality Control</p>
          <p>
            Pressure and temperature transmitters. Detailed analysis of returned devices, with documentation later used
            for improvements within the department.
          </p>
          <div class="experience-tags">
            <span>Pressure & Temp Transmitters</span>
            <span>Failure Analysis</span>
            <span>Root Cause Documentation</span>
          </div>
        </div>
      </div>

      <div class="experience-entry">
        <span class="entry-index">B</span>
        <div>
          <div class="entry-top">
            <h3>Altpro</h3>
            <span class="entry-loc">Quality Lab · Zagreb · Nov 2013 – Dec 2017</span>
          </div>
          <p class="entry-role">Quality Control & Calibration</p>
          <p>
            Railway safety systems. Measurement, calibration and quality work in a department closely connected to
            development.
          </p>
          <div class="experience-tags">
            <span>Railway Safety Systems</span>
            <span>Sensor Calibration</span>
            <span>Development QA</span>
          </div>
        </div>
      </div>

      <div class="experience-entry">
        <span class="entry-index">C</span>
        <div>
          <div class="entry-top">
            <h3>Independent technical work</h3>
            <span class="entry-loc">Field Work · Brussels</span>
          </div>
          <p class="entry-role">Hands-on Technical Work</p>
          <p>
            Appliance repairs, installations and renovations. Learning unfamiliar tasks, diagnosing problems and making
            practical solutions work.
          </p>
          <div class="experience-tags">
            <span>Hardware Diagnostics</span>
            <span>Appliance & Electrical Repair</span>
            <span>Practical Problem Solving</span>
          </div>
        </div>
      </div>
    </section>

    <section aria-labelledby="other-title">
      <div class="section-heading"><span class="folio-label">03 / OTHER WORK</span></div>
      <h2 id="other-title">Other things I have built.</h2>
      <HobbyCards />
    </section>

    <section class="learning">
      <div class="section-heading"><span class="folio-label">04 / SKILLS & LEARNING</span></div><h2>
        Learning by doing.
      </h2><p>
        PC assembly and diagnostics. Linux, macOS and Windows. Quality control and calibration. Completed Java studies.
        My next learning focus is Python, alongside the development of MILA*.
      </p><a class="text-action" href="/skills/">Skills & course certificates <Icon name="arrow" /></a>
    </section>
    <section class="contact-note">
      <p class="folio-label">NEXT CHAPTER</p><h2>Ready for the next<br />technical challenge.</h2><p>
        Quality, testing, technical support and integration — especially where hardware meets software.
      </p><a class="text-action" href="/contact/">Send a message <Icon name="arrow" /></a>
    </section>
  </div>
</LayoutDefault>
<style>
  .notebook {
    --ink: #26333b;
    --muted: #647078;
    --accent: #39776c;
    color: var(--ink);
    padding-right: 8px;
    font-family: 'IBM Plex Mono', monospace;
  }
  :global(html.dark) .notebook {
    --ink: #e7ecf3;
    --muted: #a6b2ba;
    --accent: #9ad7c7;
  }
  .notebook section {
    margin-bottom: 56px;
  }
  .folio-label {
    font-size: 10px;
    letter-spacing: 1.6px;
    font-weight: 500;
    color: var(--muted);
    line-height: 1.7;
  }
  .intro {
    padding: 12px 0 28px;
    border-bottom: 1px solid currentColor;
  }
  h1 {
    font-family: 'MyFont', monospace;
    font-size: clamp(34px, 4.1vw, 49px);
    line-height: 1.17;
    letter-spacing: -1.5px;
    margin: 23px 0;
  }
  h2 {
    font-size: 23px;
    line-height: 1.4;
    letter-spacing: -0.7px;
    margin: 18px 0;
  }
  h3 {
    font-size: 17px;
    margin: 0 0 6px;
  }
  p {
    font-size: 13px;
    line-height: 1.9;
    margin: 12px 0;
  }
  .lead {
    font-size: 14px;
    max-width: 590px;
  }
  .intro-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 28px;
    margin-top: 28px;
  }
  .intro-links a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color 0.18s ease;
  }
  .intro-links a svg {
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .intro-links a:hover svg {
    transform: translateX(4px);
  }
  .intro-links .cta {
    gap: 12px;
    padding: 12px 18px;
    background: var(--accent);
    color: #fff;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.18s ease;
  }
  .intro-links .cta:hover {
    background: #2e6359;
    color: #fff;
  }
  :global(html.dark) .intro-links .cta {
    background: #aed1c2;
    color: #24313b;
  }
  :global(html.dark) .intro-links .cta:hover {
    background: #c6e2d6;
  }
  a {
    color: inherit;
  }
  .section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid color-mix(in srgb, currentColor 22%, transparent);
    padding-bottom: 13px;
    margin-bottom: 22px;
    gap: 8px;
  }
  .status {
    font-size: 12px;
    white-space: nowrap;
    color: var(--accent);
  }
  .status i {
    display: inline-block;
    width: 6px;
    height: 6px;
    background: currentColor;
    border-radius: 50%;
    margin-right: 6px;
  }
  .project-image {
    display: block;
    border: 1px solid #7d888e;
    padding: 7px;
    background: color-mix(in srgb, var(--ink) 3%, transparent);
    text-decoration: none;
    overflow: hidden;
    transition: border-color 0.2s ease;
  }
  .project-image img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .project-image:hover {
    border-color: var(--accent);
  }
  .project-image:hover img {
    transform: scale(1.018);
  }
  .project-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .project-heading h2 {
    font-size: 30px;
  }
  .project-heading .folio-label {
    font-size: 9px;
    max-width: 150px;
    text-align: right;
  }
  .project-specs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 20px 0;
  }
  .project-specs span {
    font-size: 12px;
    padding: 5px 8px;
    border: 1px solid color-mix(in srgb, currentColor 22%, transparent);
  }
  .text-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 12px;
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid var(--accent);
    padding: 13px 0;
    color: var(--accent);
    transition: opacity 0.18s ease;
  }
  .text-action svg {
    transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .text-action:hover svg {
    transform: translateX(5px);
  }
  .experience-entry {
    display: grid;
    grid-template-columns: 30px 1fr;
    gap: 16px;
    padding: 23px 0;
    border-bottom: 1px solid color-mix(in srgb, currentColor 16%, transparent);
  }
  .entry-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .entry-loc {
    font-size: 11px;
    letter-spacing: 1px;
    color: var(--muted);
    text-transform: uppercase;
  }
  .entry-index {
    font-size: 12px;
    color: var(--muted);
    padding-top: 4px;
  }
  .entry-role {
    font-size: 11px;
    color: var(--accent);
    margin: 4px 0 10px;
  }
  .experience-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
  }
  .experience-tags span {
    font-size: 12px;
    padding: 4px 8px;
    border: 1px solid color-mix(in srgb, currentColor 18%, transparent);
    border-radius: 2px;
    color: var(--muted);
    background: color-mix(in srgb, var(--ink) 2%, transparent);
  }
  :global(html.dark) .experience-tags span {
    border-color: #556975;
    color: #b6c4c9;
    background: color-mix(in srgb, var(--accent) 4%, transparent);
  }
  .experience-entry p:last-child {
    margin-bottom: 0;
  }
  .contact-note {
    border: 1px solid color-mix(in srgb, currentColor 35%, transparent);
    padding: 22px;
    background: color-mix(in srgb, var(--accent) 4%, transparent);
  }
  .contact-note h2 {
    font-size: 22px;
  }
  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
  @media (max-width: 600px) {
    .notebook {
      padding: 0;
    }
    .notebook section {
      margin-bottom: 40px;
    }
    h1 {
      font-size: 35px;
    }
    .project-heading {
      align-items: flex-start;
    }
    .project-heading .folio-label {
      padding-top: 22px;
    }
    .entry-top {
      flex-direction: column;
      gap: 2px;
    }
  }
</style>
