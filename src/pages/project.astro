---
import { getEntry, render } from 'astro:content'
import LayoutDefault from '~/layouts/LayoutDefault.astro'
import { formatDate } from '~/utils'

const { translate: t } = Astro.locals
const projectPost = await getEntry('spec', 'project')
if (!projectPost) {
  throw new Error('No project post found')
}
const { Content } = await render(projectPost)
---

<LayoutDefault>
  <header flex="~ col gap-2">
    <h1 class="post-title">
      <a class="not-prose">{projectPost.data.title}</a>
    </h1>
    <div class="text-3.5">
      <span>{t('posted_at')}</span>
      <time>{formatDate(projectPost.data.pubDate)}</time>
    </div>
  </header>
  <article class="prose">
    <Content />
  </article>
</LayoutDefault>
