---
import HobbyVideo from '~/components/HobbyVideo.astro'
import LayoutDefault from '~/layouts/LayoutDefault.astro'
---

<LayoutDefault
  title="Interior painting — Gordan Grgić"
  description="Interior painting, from masking the space to spray application and finishing details."
  image="/og/interior-painting.jpg"
  imageAlt="Spray painting along the edge of an interior wall"
>
  <a class="painting-back" href="/hobbies/">← All hands-on projects</a>
  <article class="painting-page">
    <div class="hero">
      <div class="hero-copy">
        <p class="label">Interiors / Finishing work</p><h1>Interior painting</h1><p>
          Before painting, I cover the floors, woodwork and furniture. I use long, even passes on larger surfaces and
          slow down at the edges to keep a clean line.
        </p><a class="cta" href="#video">Watch the footage ↓</a>
      </div><figure>
        <img
          data-group="painting"
          data-index="1"
          src="/images/hobbies/interior-painting/bojanje-interijera.jpg"
          alt="Wearing a protective suit, I raise the spray gun toward the edge of the wall."
          width="1448"
          height="1086"
          fetchpriority="high"
        /><figcaption>Painting along the edge of a wall in a 120 m² apartment.</figcaption>
      </figure>
    </div>
    <section class="section" id="usporedba">
      <div class="section-heading"><h2>Before and after</h2></div><div class="wall-comparison">
        <figure>
          <img
            data-group="painting"
            data-index="2"
            src="/images/hobbies/interior-painting/pukotine.jpg"
            alt="Original photograph of the cracked wall."
            width="1125"
            height="1500"
            loading="lazy"
          /><figcaption><strong>Before</strong></figcaption>
        </figure><figure>
          <img
            data-group="painting"
            data-index="3"
            src="/images/hobbies/interior-painting/zid-gletanje-bojanje.png"
            alt="The wall with a smooth white painted surface."
            width="1086"
            height="1449"
            loading="lazy"
          /><figcaption><strong>After</strong>Smooth white finish.</figcaption>
        </figure>
      </div>
    </section>
    <section class="section">
      <div class="section-heading"><h2>Masking and finishing details</h2></div><div class="grid gallery-pair">
        <figure class="photo">
          <img
            data-group="painting"
            data-index="4"
            src="/images/hobbies/interior-painting/priprema.jpg"
            alt="Paper covers the steps and floor. Sheeting protects the doors and stair rail."
            width="1125"
            height="1500"
            loading="lazy"
          /><figcaption>
            <strong>Masking the space</strong>Paper covers the steps and floor. Sheeting protects the doors and stair
            rail.
          </figcaption>
        </figure><figure class="photo">
          <img
            data-group="painting"
            data-index="5"
            src="/images/hobbies/interior-painting/hodnik.jpg"
            alt="Painted walls alongside a timber floor and a white stair rail."
            width="1125"
            height="1500"
            loading="lazy"
          /><figcaption>
            <strong>Finishing details</strong>Painted walls alongside a timber floor and a white stair rail.
          </figcaption>
        </figure>
      </div>
    </section>
    <section id="video" class="section media">
      <div class="section-heading"><h2>The work on film</h2></div><div class="grid three">
        <figure class="clip">
          <HobbyVideo
            src="/videos/interior-painting/zastita.mp4"
            poster="/images/hobbies/interior-painting/poster-zastita.jpg"
            label="Preparing to paint"
          /><figcaption>
            <strong>Preparing to paint</strong>Furniture, kitchen units and windows under protective sheeting.
          </figcaption>
        </figure><figure class="clip featured-clip">
          <HobbyVideo
            src="/videos/interior-painting/bojanje.mp4"
            poster="/images/hobbies/interior-painting/poster-bojanje.jpg"
            label="Spray painting"
          /><figcaption>
            <strong>Spray painting</strong>Painting in a 120 m² apartment. Watch the rhythm of the passes and the change
            of direction at the edge of the wall.
          </figcaption>
        </figure><figure class="clip">
          <HobbyVideo
            src="/videos/interior-painting/obilazak.mp4"
            poster="/images/hobbies/interior-painting/poster-obilazak.jpg"
            label="Walking through the space"
          /><figcaption>
            <strong>Walking through the space</strong>Walls and ceiling in natural light. This clip is silent.
          </figcaption>
        </figure>
      </div>
    </section>
    <section class="section gear">
      <h2>Equipment I use</h2><div class="gear-grid">
        <div class="gear-card">
          <img
            src="/images/hobbies/interior-painting/prospray-320.jpg"
            alt="WAGNER ProSpray 3.20"
            width="800"
            height="800"
            loading="lazy"
          /><p class="gear-use">Walls</p><h3>WAGNER ProSpray 3.20</h3><p class="gear-description">
            Airless application for larger wall surfaces, with paint drawn directly from the container.
          </p><a
            class="gear-source"
            href="https://www.wagner-group.com/en/contractor/products-and-accessories/product/prospray-320-hea-spraypack/"
            target="_blank"
            rel="noopener">WAGNER — product details ↗</a
          >
        </div><div class="gear-card">
          <img
            src="/images/hobbies/interior-painting/powerpainter-90.jpg"
            alt="WAGNER PowerPainter 90"
            width="800"
            height="800"
            loading="lazy"
          /><p class="gear-use">Walls</p><h3>WAGNER PowerPainter 90</h3><p class="gear-description">
            Airless spraying for interior painting, with a wheeled frame for moving the equipment between rooms.
          </p><a
            class="gear-source"
            href="https://www.wagner-group.com/en/contractor/products-and-accessories/product/powerpainter-90-extra-spraypack/"
            target="_blank"
            rel="noopener">WAGNER — product details ↗</a
          >
        </div><div class="gear-card">
          <img
            src="/images/hobbies/interior-painting/finishcontrol-5500.jpg"
            alt="WAGNER FinishControl 5500"
            width="800"
            height="800"
            loading="lazy"
          /><p class="gear-use">Wood and metal</p><h3>WAGNER FinishControl 5500</h3><p class="gear-description">
            XVLP spraying for varnishes, primers and finishing coats on wood and metal.
          </p><a
            class="gear-source"
            href="https://www.wagner-group.com/en/contractor/products-and-accessories/product/finishcontrol-5500/"
            target="_blank"
            rel="noopener">WAGNER — product details ↗</a
          >
        </div>
      </div><p class="gear-credit">
        Equipment photographs © WAGNER. PowerPainter is shown in the 90 Extra configuration.
      </p>
    </section>
  </article>
</LayoutDefault>
<script>
  document.addEventListener(
    'play',
    (event) => {
      if (!(event.target instanceof HTMLVideoElement) || !event.target.closest('.painting-page')) {
        return
      }
      document.querySelectorAll<HTMLVideoElement>('.painting-page video').forEach((video) => {
        if (video !== event.target) {
          video.pause()
        }
      })
    },
    true,
  )
</script>
<style>
  .painting-back {
    display: inline-block;
    margin-bottom: 24px;
    font:
      12px 'IBM Plex Mono',
      monospace;
  }
  .painting-page {
    font-family: var(--body-font, sans-serif);
  }
  .painting-page h1,
  .painting-page h2,
  .painting-page h3,
  .painting-page p,
  .painting-page figure {
    margin: 0;
  }
  .painting-page h1 {
    font-size: clamp(42px, 6vw, 78px);
    line-height: 1.06;
    letter-spacing: -0.045em;
  }
  .painting-page h2 {
    font-size: clamp(26px, 3.8vw, 42px);
    line-height: 1.15;
    letter-spacing: -0.04em;
  }
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid color-mix(in srgb, currentColor 25%, transparent);
  }
  .hero-copy {
    padding: 32px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 23px;
  }
  .label {
    font:
      11px/1.6 'IBM Plex Mono',
      monospace;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .hero-copy > p:not(.label) {
    font-size: 17px;
    line-height: 1.8;
    opacity: 0.8;
  }
  .cta {
    padding: 10px 14px;
    border: 1px solid currentColor;
    font:
      12px 'IBM Plex Mono',
      monospace;
    text-decoration: none;
  }
  .hero figure {
    padding: 8px;
  }
  .hero img {
    display: block;
    width: 100%;
    height: 450px;
    object-fit: cover;
  }
  .painting-page figcaption {
    font:
      12px/1.6 'IBM Plex Mono',
      monospace;
    margin-top: 8px;
  }
  .painting-page figcaption strong {
    display: block;
    font-size: 14px;
    line-height: 1.6;
  }
  .section {
    padding: 44px 0;
    border-bottom: 1px solid color-mix(in srgb, currentColor 25%, transparent);
  }
  .section-heading {
    margin-bottom: 22px;
  }
  .wall-comparison,
  .gallery-pair,
  .three {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }
  .wall-comparison img,
  .photo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3/4;
    object-fit: cover;
  }
  .three {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  video {
    display: block;
    width: 100%;
    aspect-ratio: 9/16;
    object-fit: contain;
    background: #17201e;
  }
  .equipment {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 25px;
  }
  .equipment dl {
    margin: 0;
  }
  .equipment dt {
    font:
      12px 'IBM Plex Mono',
      monospace;
  }
  .equipment dd {
    margin: 4px 0 18px;
    font-weight: 600;
  }
  @media (max-width: 650px) {
    .hero,
    .gallery-pair,
    .three,
    .equipment {
      grid-template-columns: 1fr;
    }
    .hero-copy {
      padding: 25px 20px;
    }
    .hero img {
      height: 310px;
    }
    .wall-comparison {
      gap: 10px;
    }
    .wall-comparison figcaption strong {
      font-size: 12px;
    }
    .clip {
      display: grid;
      grid-template-columns: 53% 1fr;
      gap: 14px;
      align-items: center;
    }
  }

  .gear-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 24px;
  }
  .gear-card img {
    width: 100%;
    height: 220px;
    object-fit: contain;
    background: #fff;
    padding: 10px;
    display: block;
  }
  .gear-card h3 {
    font-size: 19px;
    line-height: 1.4;
    margin: 8px 0 !important;
  }
  .gear-card .gear-use {
    font:
      11px 'IBM Plex Mono',
      monospace;
    margin-top: 14px !important;
  }
  .gear-card .gear-description {
    font-size: 14px;
    line-height: 1.7;
    margin: 10px 0 !important;
  }
  .gear-card .gear-source {
    display: inline-block;
    font:
      11px/1.7 'IBM Plex Mono',
      monospace;
    margin-top: 8px;
  }
  .gear-credit {
    margin-top: 22px !important;
    font:
      11px/1.7 'IBM Plex Mono',
      monospace;
    opacity: 0.7;
  }
  @media (max-width: 650px) {
    .gear-grid {
      grid-template-columns: 1fr;
    }
    .gear-card img {
      height: 250px;
    }
  }

  .media .three {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .media .featured-clip {
    grid-column: 1/-1;
    grid-row: 1;
    width: min(100%, 440px);
    justify-self: center;
  }
  @media (max-width: 650px) {
    .media .three {
      grid-template-columns: 1fr;
    }
    .media .featured-clip {
      display: block;
      width: 100%;
    }
  }
</style>
