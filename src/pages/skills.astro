---
import { getEntry, render } from 'astro:content'
import LayoutDefault from '~/layouts/LayoutDefault.astro'
const entry = await getEntry('spec', 'skills')
if (!entry) throw new Error('Missing skills content')
const { Content } = await render(entry)
---

<LayoutDefault title="Skills & certificates — Gordan Grgić" description={entry.data.description}
  ><header class="page-heading">
    <p class="folio-label">PERSONAL FIELD NOTES / EXPERIENCE & EDUCATION</p><h1>Skills & experience</h1>
  </header><article class="prose"><Content /></article></LayoutDefault
>

<style is:global>
  .prose .skill-item-icon {
    display: inline-block;
    width: 17px;
    height: 17px;
    margin-right: 8px;
    vertical-align: -3px;
    color: var(--accent);
    flex-shrink: 0;
  }
  .prose li:has(.skill-item-icon) {
    list-style: none;
  }
</style>
