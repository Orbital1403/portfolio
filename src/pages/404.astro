---
import LayoutDefault from '~/layouts/LayoutDefault.astro'
import Icon from '~/components/Icon.astro'
---

<LayoutDefault title="Page not found — Gordan Grgić" description="This page does not exist on gordangrgic.com." noindex>
  <section class="not-found">
    <p class="folio-label">PERSONAL FIELD NOTES / 404</p>
    <h1>Page not found.</h1>
    <p>This address does not lead to a page. It may have moved when the site was reorganised.</p>
    <ul>
      <li><a href="/">Home <Icon name="arrow" /></a></li>
      <li><a href="/projects/mila/">MILA* project notes <Icon name="arrow" /></a></li>
      <li><a href="/contact/">Contact <Icon name="arrow" /></a></li>
    </ul>
  </section>
</LayoutDefault>
<style>
  .not-found h1 {
    font-family: 'MyFont', monospace;
    font-size: 46px;
    font-weight: 400;
    line-height: 1.2;
    margin: 20px 0 16px;
  }
  .not-found ul {
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
    max-width: 420px;
  }
  .not-found li a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 13px 0;
    border-bottom: 1px solid color-mix(in srgb, currentColor 22%, transparent);
    font: 700 13px var(--note-font);
    text-decoration: none;
  }
  @media (max-width: 600px) {
    .not-found h1 {
      font-size: 36px;
    }
  }
</style>
