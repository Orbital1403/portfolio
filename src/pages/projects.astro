---
import { getEntry, render } from 'astro:content'
import LayoutDefault from '~/layouts/LayoutDefault.astro'
import SmartLawnCard from '~/components/SmartLawnCard.astro'
const projectPost = await getEntry('spec', 'projects')
if (!projectPost) throw new Error('No project post found')
const { Content } = await render(projectPost)
---

<LayoutDefault
  title="Projects — MILA* & Smart Lawn — Gordan Grgić"
  description="MILA*: a Raspberry Pi audio streamer for hi-res FLAC, radio and streaming. Plus Smart Lawn: a working My Garden mobile prototype for soil monitoring, with hardware integration next."
  ><header class="page-heading">
    <p class="folio-label">PERSONAL FIELD NOTES / PROJECTS</p><h1>Project notes</h1>
  </header><nav class="project-picker" aria-label="Choose a project">
    <a data-no-swup href="#mila">01 / MILA*</a><a data-no-swup href="#portfolio-project">02 / This portfolio</a>
    <a href="/projects/smart-lawn/">03 / Smart Lawn · In development</a>
  </nav><nav class="project-contents" aria-label="Project contents">
    <a data-no-swup href="#from-frustration-to-a-project">Idea</a><a
      data-no-swup
      href="#one-interface-for-everyday-listening">Features</a
    ><a data-no-swup href="#my-role-and-how-i-work">Development</a><a
      data-no-swup
      href="#development-example-keeping-favourites-consistent">Examples</a
    ><a data-no-swup href="#testing-and-releases">Testing</a><a data-no-swup href="#hardware--foundation">Hardware</a>
  </nav><nav slot="aside" class="page-contents" aria-label="On this page">
    <p>ON THIS PAGE</p><a data-no-swup href="#from-frustration-to-a-project">Idea</a><a
      data-no-swup
      href="#one-interface-for-everyday-listening">Features</a
    ><a data-no-swup href="#my-role-and-how-i-work">My role</a><a
      data-no-swup
      href="#development-example-keeping-favourites-consistent">Examples</a
    ><a data-no-swup href="#testing-and-releases">Testing</a><a data-no-swup href="#hardware--foundation">Hardware</a><a
      data-no-swup
      href="#current-state">Current state</a
    ><a data-no-swup href="#portfolio-project">This portfolio</a>
  </nav><SmartLawnCard /><article class="prose">
    <Content />
  </article></LayoutDefault
>

<style>
  .project-contents {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    padding: 14px 0;
    margin-bottom: 25px;
    border-top: 1px solid color-mix(in srgb, currentColor 20%, transparent);
    border-bottom: 1px solid color-mix(in srgb, currentColor 20%, transparent);
    font:
      11px 'IBM Plex Mono',
      monospace;
  }
  .project-contents a {
    color: inherit;
    text-decoration: none;
    padding: 4px 0;
  }
  .project-contents a:hover {
    color: #39776c;
    background: none;
  }
</style>
