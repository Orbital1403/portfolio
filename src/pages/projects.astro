---
import LayoutDefault from '~/layouts/LayoutDefault.astro'
import Icon from '~/components/Icon.astro'
const projects = [
  {
    id: 'mila',
    number: '01',
    status: 'Working prototype · Everyday listening',
    stamp: '',
    name: 'MILA*',
    category: 'Hardware + software + music',
    href: '/projects/mila/',
    image: '/images/projects/gstreamer/mila-player-queue-20261023.webp',
    alt: 'MILA audio player with album artwork and a playback queue',
    description:
      'A personal audio streamer bringing local hi-res music, internet radio and streaming together in one responsive interface. A working prototype used for everyday listening.',
    tags: ['Audio streamer', 'Python', 'Device testing'],
  },
  {
    id: 'grgagrow',
    number: '02',
    status: 'In the lawn · Live readings',
    stamp: '',
    name: 'grgaGrow',
    category: 'Soil monitoring and electronics',
    href: '/projects/grgagrow/',
    image: '/images/projects/smart-lawn/grgagrow-live-card.jpg',
    alt: 'Screenshot of the public grgaGrow dashboard showing soil moisture and temperature for sensor 1',
    description:
      'Two probes in my 49 m² lawn send soil moisture and temperature to the cloud over Wi-Fi. The readings are public on a live page.',
    tags: ['RS485', 'ESP32-S3', 'Wi-Fi'],
  },
  {
    id: 'our-laundry',
    number: '03',
    status: 'Interactive demo · Integration in development',
    stamp: 'Interactive demo',
    name: 'Our laundry',
    category: 'Shared laundry + mobile web app',
    href: '/projects/our-laundry/',
    image: '/images/projects/praonica/laundry-before-dog-800.webp',
    alt: 'A frustrated resident with a laundry basket and a small dog beside her finds both machines occupied',
    description:
      'A mobile-first project inspired by shared laundry rooms in Brussels: check machine status before carrying your laundry downstairs. Development starts with two personally owned test appliances; a future Wi-Fi sensor is being explored.',
    tags: ['Mobile web', 'Python', 'Wi-Fi / sensors'],
  },
  {
    id: 'portfolio-project',
    number: '04',
    status: 'Published · Ongoing improvements',
    stamp: '',
    name: 'Portfolio',
    category: 'Personal website',
    href: '/projects/portfolio/',
    image: '/og/default.jpg',
    alt: 'Gordan Grgić portfolio identity',
    description:
      'The website you are exploring: adapting an Astro theme into a clear, personal account of my experience, practical work and current projects.',
    tags: ['Astro', 'HTML / CSS', 'JavaScript'],
  },
]
---

<LayoutDefault
  title="Projects — MILA*, grgaGrow, Our laundry & Portfolio — Gordan Grgić"
  description="Explore MILA*, grgaGrow, Our laundry and this portfolio: personal projects connecting hardware, software and practical testing."
>
  <header class="page-heading">
    <p class="folio-label">PERSONAL FIELD NOTES / PROJECTS</p>
    <h1>Project notes</h1>
    <p class="project-intro">
      Four projects, each with its own story. Choose one to explore the idea, the work and its current state.
    </p>
  </header>
  <div class="project-cards">
    {
      projects.map((project) => (
        <article
          class:list={[
            'project-card',
            { 'laundry-card': project.id === 'our-laundry', 'grgagrow-card': project.id === 'grgagrow' },
          ]}
        >
          <div class="card-image">
            {project.id === 'portfolio-project' ? (
              <div
                class="portfolio-preview"
                role="img"
                aria-label="Portfolio website preview: Gordan Grgić, Curiosity. A practical mind."
              >
                <p class="preview-address">gordangrgic.com</p>
                <p class="preview-name">gordan grgić</p>
                <div class="preview-rule" />
                <p class="preview-note">PERSONAL FIELD NOTES / ZAGREB → BRUSSELS</p>
                <p class="preview-title">
                  Curiosity.
                  <br />A practical mind.
                </p>
                <p class="preview-footer">QUALITY · TESTING · HARDWARE + SOFTWARE</p>
              </div>
            ) : (
              <img
                src={project.image}
                alt={project.alt}
                width={project.id === 'our-laundry' ? 800 : project.id === 'grgagrow' ? 1076 : 1024}
                height={project.id === 'our-laundry' ? 533 : project.id === 'grgagrow' ? 807 : 640}
                loading="lazy"
                decoding="async"
              />
            )}
            {project.id === 'grgagrow' && <span class="photo-caption">Screenshot of the public dashboard</span>}
            {project.stamp && <span class="development-stamp">{project.stamp}</span>}
          </div>
          <div class="card-copy">
            <p class="card-label">
              {project.number} / {project.category}
            </p>
            <div class="card-heading">
              <h2 id={`${project.id}-title`}>{project.name}</h2>
              <span class="card-status">{project.status}</span>
            </div>
            <p class="card-description">{project.description}</p>
            <ul class="card-tags" aria-label="Project topics">
              {project.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
            <a
              class="card-action card-primary not-underline-hover"
              href={project.href}
              aria-labelledby={`${project.id}-title ${project.id}-action`}
            >
              <span id={`${project.id}-action`}>Explore the project</span> <Icon name="arrow" />
            </a>
            {project.id === 'grgagrow' && (
              <a class="card-action card-secondary" href="/demos/my-garden/?public=grgagrow">
                View current readings <Icon name="arrow" />
              </a>
            )}
          </div>
        </article>
      ))
    }
  </div>
</LayoutDefault>

<script>
  // Before each project had its own page, these links pointed into the projects list.
  const legacyTargets = new Map([
    ['#mila', 'mila/'],
    ['#grgagrow', 'grgagrow/'],
    ['#smart-lawn', 'grgagrow/'],
    ['#praonica', 'our-laundry/'],
    ['#our-laundry', 'our-laundry/'],
    ['#02--this-portfolio', 'portfolio/#portfolio-project'],
    ['#03--coursework--continued-learning', 'portfolio/#coursework--continued-learning'],
  ])
  const sections = new Map([
    [
      'mila',
      [
        'from-frustration-to-a-project',
        'one-interface-for-everyday-listening',
        'guide',
        'a-library-i-can-explore',
        'radio-without-the-clutter',
        'streaming-and-audio-control',
        'streaming',
        'mobile',
        'download',
        'settings-that-belong-with-the-player',
        'my-role-and-how-i-work',
        'development-example-keeping-favourites-consistent',
        'development-example-commands-that-only-looked-successful',
        'development-example-a-lost-connection-without-false-alarms',
        'testing-and-releases',
        'hardware--foundation',
        'current-state',
      ],
    ],
    ['portfolio', ['portfolio-project', 'coursework--continued-learning']],
    [
      'grgagrow',
      [
        'lawn-site',
        'lawn-hardware',
        'lawn-probe-service',
        'lawn-bench',
        'bench-readings',
        'bench-wiring',
        'bench-reading-flow',
        'bench-firmware',
        'lawn-firmware-log',
        'lawn-equipment',
        'lawn-software',
        'lawn-reliability',
        'lawn-next',
      ],
    ],
    ['our-laundry', ['system-plan', 'signal-guide']],
  ])
  for (const [project, ids] of sections) {
    for (const id of ids) {
      legacyTargets.set(`#${id}`, `${project}/#${id}`)
    }
  }

  const trailingSlash = /\/$/
  function openLegacyProject() {
    const path = window.location.pathname.replace(trailingSlash, '')
    const hash = window.location.hash
    if (!path.endsWith('/projects') || !hash || document.getElementById(hash.slice(1))) {
      return
    }
    const target = legacyTargets.get(hash)
    if (target) {
      const url = new URL(`${path}/${target}`, window.location.origin)
      url.search = window.location.search
      window.location.replace(url.href)
    }
  }
  openLegacyProject()
  document.addEventListener('astro:page-load', openLegacyProject)
  window.addEventListener('hashchange', openLegacyProject)
</script>

<style>
  .project-intro {
    max-width: 60ch;
    color: var(--note-color);
    margin: 18px 0 32px;
  }
  .project-cards {
    display: grid;
    gap: 26px;
    margin-bottom: 48px;
  }
  .project-card {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.2fr);
    color: inherit;
    border: 1px solid color-mix(in srgb, currentColor 24%, transparent);
    text-decoration: none;
    overflow: hidden;
    transition:
      border-color 0.2s,
      background 0.2s;
  }
  .project-card:hover {
    color: inherit;
    background: color-mix(in srgb, #39776c 5%, transparent);
    border-color: #39776c;
  }
  .card-primary {
    color: inherit;
  }
  .card-primary::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .card-secondary {
    position: relative;
    z-index: 1;
  }
  .project-card:has(.card-primary:focus-visible) {
    outline: 2px solid #39776c;
    outline-offset: 5px;
  }
  .card-image {
    position: relative;
    display: flex;
    align-items: center;
    background: color-mix(in srgb, currentColor 4%, transparent);
    border-right: 1px solid color-mix(in srgb, currentColor 15%, transparent);
  }
  .card-image img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .grgagrow-card .card-image {
    flex-direction: column;
    align-items: stretch;
    justify-content: center;
  }
  .photo-caption {
    display: block;
    padding: 7px 14px;
    border-top: 1px solid color-mix(in srgb, currentColor 15%, transparent);
    font: 11px/1.5 var(--note-font);
    color: var(--note-color, inherit);
  }
  .grgagrow-card .card-image img {
    aspect-ratio: 4 / 3;
    object-fit: contain;
  }
  .laundry-card .card-image {
    position: relative;
    background: #f4f4ec;
    padding: 50px 0 12px;
  }
  .laundry-card .card-image img {
    aspect-ratio: 3 / 2;
    object-fit: contain;
  }
  .development-stamp {
    position: absolute;
    top: 20px;
    right: 18px;
    transform: rotate(-9deg);
    padding: 7px 11px;
    border: 3px double #39776c;
    border-radius: 3px 6px 2px 5px;
    color: #326b60;
    background: #f4f4ec;
    box-shadow: 1px 1px 0 #39776c55;
    font: 700 12px/1.5 var(--note-font);
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }
  .portfolio-preview {
    box-sizing: border-box;
    width: 100%;
    padding: 28px;
    color: inherit;
  }
  .preview-address {
    font: 10px/1.6 var(--note-font);
    color: var(--note-color);
    margin: 0 0 20px;
  }
  .preview-name {
    font:
      28px/1.1 'MyFont',
      monospace;
    margin: 0 0 16px;
  }
  .preview-rule {
    border-top: 1px solid color-mix(in srgb, currentColor 22%, transparent);
    margin-bottom: 24px;
  }
  .preview-note,
  .preview-footer {
    font: 8px/1.8 var(--note-font);
    color: var(--note-color);
    margin: 0;
  }
  .preview-title {
    font:
      38px/1.1 'MyFont',
      monospace;
    margin: 14px 0 24px;
  }
  .card-copy {
    padding: 24px;
    min-width: 0;
  }
  .card-label {
    font: 10px/1.7 var(--note-font);
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: var(--note-color);
    margin: 0 0 14px;
  }
  .card-heading {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .card-heading h2 {
    font:
      40px/1.1 'MyFont',
      monospace;
    margin: 0;
    letter-spacing: 0.5px;
  }
  .card-status {
    font: 11px/1.6 var(--note-font);
    max-width: 100%;
    overflow-wrap: anywhere;
    padding: 4px 7px;
    border: 1px solid color-mix(in srgb, currentColor 25%, transparent);
  }
  .card-description {
    font: 14px/1.8 var(--body-font);
    margin: 16px 0;
  }
  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    list-style: none;
    padding: 0;
    margin: 0;
    font: 10px/1.7 var(--note-font);
    color: var(--note-color);
  }
  .card-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border-top: 1px solid color-mix(in srgb, currentColor 18%, transparent);
    padding-top: 14px;
    margin-top: 20px;
    font: 11px/1.6 var(--note-font);
  }
  @media (max-width: 680px) {
    .project-card {
      grid-template-columns: 1fr;
    }
    .card-image {
      border-right: 0;
      border-bottom: 1px solid color-mix(in srgb, currentColor 15%, transparent);
    }
    .card-image img {
      aspect-ratio: 16 / 9;
    }
    .card-copy {
      padding: 20px;
    }
    .card-heading h2 {
      font-size: 36px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .project-card {
      transition: none;
    }
  }
</style>
