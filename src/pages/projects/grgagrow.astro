          />
          <figcaption>CONTROLLER DETAIL / The original focus of the bench photograph is preserved.</figcaption>
        </figure>
      </div>
      <BenchResults>
        <details slot="code" class="code-toggle bench-code">
          <summary>Show the C++ excerpt · modbus_rtu.cpp</summary>
          <p class="note">
            An actual excerpt from the shared firmware module. A complete response goes to validation; a timeout or
            transport fault returns an explicit error.
          </p>
          <Code
            code={firmwareExample}
            lang="cpp"
            themes={{ light: 'github-light', dark: 'github-dark' }}
            tabindex="0"
            data-firmware-code="true"
          />
        </details>
      </BenchResults>
      <div
        class="architecture"
        aria-label="Planned data path: two soil probes connect via RS485 and Modbus RTU to an ESP32 controller, then via Wi-Fi and HTTPS to ingestion, PostgreSQL and the authenticated My Garden app."
      >
        <div class="probe-row">
          <span>Probe 01<br /><small>Moisture + temperature</small></span><span
            >Probe 02<br /><small>Moisture + temperature + pH*</small></span
          >
        </div>
        <p class="flow-label">↓ RS485 / Modbus RTU · BITNER LP0170 cable</p>
        <div class="architecture-node">ESP32-S3 controller</div>
        <p class="flow-label">↓ Wi-Fi / HTTPS</p>
        <div class="architecture-node">Ingestion → PostgreSQL</div>
        <p class="flow-label">↓ Authenticated access</p>
        <div class="architecture-node app-node">grgaGrow / My Garden</div>
        <p class="note architecture-note">
          Full data path verified on the bench · Field installation in progress · *pH is experimental
        </p>
      </div>
      <h3 id="lawn-firmware-log" class="block-title">Seven problems between the bench and the cloud.</h3>
      <p>
        Most of the work happened between a probe that answers and a reading that can be trusted. Each card is a real
        problem from the bench, what caused it and what changed.
      </p>
      <ol class="fix-log">
        {
          firmwareFixes.map((item) => (
            <li>
              <h4>{item.title}</h4>
              <dl>
                <div>
                  <>
