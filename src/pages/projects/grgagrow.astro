            width="1536"
            height="1024"
            loading="lazy"
            decoding="async"
            data-group="grgagrow-bench"
            data-index="0"
            data-title="First bench setup — one controller and one TH probe during a water test. Edited photograph."
            tabindex="0"
            role="button"
            aria-label="Enlarge the bench setup photograph"
          />
          <figcaption>FIRST BENCH SETUP / One ESP32 controller and one TH probe during a water test.</figcaption>
        </figure>
        <figure>
          <img
            src="/images/projects/smart-lawn/bench/controller-current.webp"
            alt="Edited bench photograph showing the controller and a multimeter displaying 48.31 mA DC"
            width="1448"
