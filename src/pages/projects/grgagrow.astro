      <figure class="dashboard-figure installation-overview">
        <img
          src="/images/projects/smart-lawn/build/installation-modules-en.webp"
          data-hr-src="/images/projects/smart-lawn/build/installation-modules-hr.webp"
          data-src="/images/projects/smart-lawn/build/installation-modules-en.webp"
