const firmwareExample =
  'Response readRegisters(const Request& request, Exchange& exchange, uint32_t budget_ms) {\n  Frame outgoing, incoming;\n  if (!encodeRequest(request, outgoing) || budget_ms == 0) return error(Status::InvalidRequest);\n  switch (exchange.transact(outgoing, budget_ms, incoming)) {\n    case Io::Complete:\n      return decodeResponse(request, incoming);\n    case Io::Timeout:\n      return error(Status::Timeout);\n    case Io::Fault:\n      return error(Status::TransportFault);\n  }\n  return error(Status::TransportFault);\n}'

const scanExample =
  'for (unsigned unit = 1; unit <= 247; ++unit) {\n  const auto u = static_cast<uint8_t>(unit);\n  const auto th = holding(bus_, u, soil::TemperatureMoistureRegister, 2, timing_.scan_budget_ms);\n  if (th.status != modbus::Status::Ok || th.count != 2) continue;\n  const auto ph = holding(bus_, u, soil::PhRegister, 1, timing_.scan_budget_ms);\n  const bool has_ph = ph.status == modbus::Status::Ok && ph.count == 1 &&\n                      ph.registers[0] > 0 && ph.registers[0] <= 140;\n  for (size_t i = 0; i < channels_.size(); ++i)\n    if (channels_[i].unit == u && channels_[i].has_ph == has_ph) still_there[i] = true;\n  auto& slot = found[has_ph ? 1 : 0];\n  if (!slot) slot = u;\n}'

const bridgeExample =
  'const char* allowed(const gg::modbus::Frame& f) {\n  const auto* b = f.bytes.data();\n  if (f.size < 8) return "short";\n  const uint16_t c = crc(b, f.size - 2);\n  if (b[f.size - 2] != (c & 0xff) || b[f.size - 1] != (c >> 8)) return "crc";\n  if (b[0] < 1 || b[0] > 247) return "unit";\n  const uint16_t reg = (b[2] << 8) | b[3];\n  switch (b[1]) {\n    case 3:\n    case 4:\n      return f.size == 8 ? nullptr : "length";\n    case 0x10: {\n      const uint16_t count = (b[4] << 8) | b[5];\n      if (f.size != 11 || reg != AddressRegister || count != 1 || b[6] != 2) return "write-locked";\n      const uint16_t value = (b[7] << 8) | b[8];\n      return (value >= 1 && value <= 247) ? nullptr : "value";\n    }\n    default:\n      return "function";\n  }\n}'

const firmwareFixes = [
  {
    title: 'An address write that never left the board',
    problem: 'Both probes shipped at Modbus address 02. Every attempt to move the TH probe ended as "outcome unknown".',
    cause:
      'The guarded UART transmit path only passed 8-byte frames, the size of a read. The 11-byte FC10 write was silently dropped.',
    fix: 'A RAM-only image sent the full frame. TH moved to 03, survived a power cycle, and both probes now share one bus.',
  },
  {
    title: 'A crash before the first reading',
    problem: 'The first flashed firmware restarted in a loop during start-up.',
    cause: 'Resetting the reading queue built a temporary of about 13 KB on a main-task stack of 3.5 KB.',
    fix: 'The queue reset no longer builds that temporary on the stack. The board boots and stays up.',
  },
  {
    title: 'Wi-Fi that could never connect',
    problem: 'The board stayed offline after the first flash.',
    cause: 'The first configuration named a 5 GHz network. The ESP32-S3 radio only supports 2.4 GHz.',
    fix: 'A 2.4 GHz network, NTP time and the first acknowledged uploads to Supabase.',
  },
  {
    title: 'Zeros after power-up',
    problem: 'Right after power-up both probes answered with 0 °C and 0 % moisture.',
    cause: 'A valid Modbus reply is not yet a settled measurement.',
    fix: 'For the first 30 seconds the firmware marks answers as not settled and withholds the values.',
  },
  {
    title: 'pH that needs time',
    problem: 'The pH register returned values before the probe could measure.',
    cause:
      'The THP probe needs about five minutes of power after a real power loss; a software restart does not reset it.',
    fix: 'pH is withheld until the warm-up has passed. Temperature and moisture are still reported.',
  },
  {
    title: 'A probe that moved',
    problem: 'A probe that stops answering at its configured address would leave a permanent gap.',
    cause: 'Addresses can change during service work, and a single missed reply after a reset is normal.',
    fix: 'The firmware asks again, then scans addresses 1–247 read-only and recognises each probe by its pH register.',
  },
  {
    title: 'Updates without a cable',
    problem: 'Every firmware change needed USB and download mode.',
    cause: 'The original partition table had no room for a second image.',
    fix: 'An OTA layout with two 3 MB slots and a rollback bootloader. The board fetched a release from Supabase, verified it and restarted on it.',
  },
]

const milestones = [
  ['17 Nov', 'First response', 'TH probe in wetted soil: 21.1 °C and 21.4 %.', 'done'],
  ['19 Nov', 'From a glass of water to potting soil', 'THP probe in a pot: 22.6 °C, 19.4 % and pH 6.5.', 'done'],
  ['20 Nov', 'Two probes, one bus', 'TH moved to address 03; both probes read together.', 'done'],
  ['21 Nov', 'Firmware and cloud', 'Production firmware on 12 V, uploads acknowledged, OTA working.', 'done'],
  ['Next', 'Into the lawn', 'Bury both probes, check readings in soil, then calibrate.', 'next'],
]

const probeServiceTabs = [
  ['Device', 'Listens to the installed firmware over USB: version, Wi-Fi, time, both probes, queue and uploads.'],
  ['Probes', 'Live temperature, moisture and pH with history and a stability state.'],
  ['Bus scan', 'Read-only FC03 sweep of Modbus units 1–247.'],
  [
    'Change address',
    'FC10 write to register 0x0080, only after typing a confirmation and reading back the new address.',
  ],
  ['Calibration', 'Two-point pH (buffers 7 and 4) and moisture. Raw readings stay unchanged.'],
  ['Burial mode', 'Slow polling and stability guidance while probes settle in soil.'],
  ['Firmware update', 'Checks the partition table first and writes only the application slot.'],
  ['Frame log', 'Every transmitted and received frame, also saved to a log file.'],
]

