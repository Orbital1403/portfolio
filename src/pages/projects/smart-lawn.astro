    min-width: 0;
    margin: 0;
    border: 1px solid color-mix(in srgb, currentColor 20%, transparent);
  }
  .hardware-photo img {
    width: 100%;
    height: 186px;
    object-fit: contain;
    padding: 12px;
    background: #fff;
    cursor: zoom-in;
    border-bottom: 1px solid color-mix(in srgb, currentColor 15%, transparent);
  }
  .hardware-photo img:focus-visible {
    outline: 2px solid #39776c;
    outline-offset: 3px;
  }
  .hardware-photo figcaption {
    padding: 14px;
