---
import LayoutDefault from '~/layouts/LayoutDefault.astro'

const hardwareGallery = [
  {
    image: 'esp32-s3-rs485-can.jpg',
    width: 800,
    height: 800,
    title: 'ESP32-S3 controller',
    detail: 'RS485 / CAN · Wi-Fi · DIN housing',
    alt: 'Waveshare reference photograph of the ESP32-S3-RS485-CAN controller in its DIN-rail housing',
    source: 'https://www.waveshare.com/product/esp32-s3-rs485-can.htm',
    vendor: 'Waveshare',
  },
  {
    image: 'soil-th-reference.jpg',
    width: 400,
    height: 400,
    title: 'Moisture + temperature',
    detail: 'RS485 soil probe',
    alt: 'Renke reference image of a soil temperature and moisture probe',
    source: 'https://www.renkeer.com/product/soil-moisture-sensor/',
    vendor: 'Renke',
  },
  {
    image: 'soil-ph-th-reference.jpg',
    width: 500,
    height: 500,
    title: 'Moisture + temperature + pH',
    detail: 'Combined probe · Experimental pH',
    alt: 'Renke reference image of a multi-parameter soil probe with metal sensing pins',
    source: 'https://www.renkeer.com/product/soil-nutrient-sensor/',
    vendor: 'Renke',
  },
  {
    image: 'enclosure-reference.jpg',
    width: 970,
    height: 728,
    title: 'Project enclosure',
    detail: 'Protected housing for electronics',
    alt: 'Adafruit reference photograph of an electronics enclosure with a clear lid and cable glands',
    source: 'https://www.adafruit.com/product/3931',
    vendor: 'Adafruit',
  },
  {
    image: 'din-rails-reference.jpg',
    width: 800,
    height: 800,
