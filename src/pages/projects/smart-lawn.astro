  }
  .hardware-photo p,
  .hardware-photo a {
    font: 10px/1.7 var(--note-font);
    margin: 0;
  }
  .hardware-photo a {
    display: inline-block;
    margin-top: 10px;
  }
  .hardware-label {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    flex-wrap: wrap;
    font: 9px/1.8 var(--note-font);
    opacity: 0.7;
  }
  .roadmap {
    list-style: decimal-leading-zero;
    padding-left: 34px;
  }
  .roadmap li {
    padding: 10px 0 10px 10px;
  }
  .roadmap li::marker {
    font: 12px var(--note-font);
    color: #39776c;
  }
  .roadmap strong {
    font: 15px/1.8 var(--note-font);
  }
  .roadmap p {
    font-size: 14px;
    margin: 6px 0;
  }
  .closing-demo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
    padding: 22px 0;
    border-top: 1px solid color-mix(in srgb, currentColor 20%, transparent);
    margin-top: 24px;
  }
  .closing-demo h3 {
    margin-top: 0;
  }
  .closing-demo p {
    font-size: 13px;
    margin: 0;
  }
  :global(html.dark) .project-state {
    color: #aed1c2;
  }
  :global(html.dark) .roadmap li::marker {
    color: #aed1c2;
  }
  @media (max-width: 600px) {
    .hardware-gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px 10px;
    }
    .hardware-photo img {
      height: 150px;
      padding: 8px;
    }
    .hardware-photo figcaption {
      padding: 12px;
    }
    h1 {
      font-size: 38px;
    }
    h2 {
      font-size: 21px;
    }
    .lead {
      font-size: 20px;
    }
    .feature-grid,
    .hardware-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .architecture {
      padding: 14px;
    }
    .probe-row {
      gap: 8px;
    }
    .probe-row span {
      font-size: 11px;
