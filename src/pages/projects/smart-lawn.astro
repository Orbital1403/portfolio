const hardware = [
  {
    number: '01',
    title: 'ESP32-S3 controller',
    status: 'Ordered',
    description:
      'A board sold as ESP32-S3-RS485-CAN will bridge the wired probes and Wi-Fi. The exact board variant, pin mapping and power requirements still need to be verified on arrival.',
  },
  {
    number: '02',
    title: 'Two wired soil probes',
    status: 'Ordered',
    description:
      'One moisture / temperature probe and a second with an additional pH channel. RS485 / Modbus RTU is the intended connection; register maps, scaling and calibration come next. pH is experimental.',
  },
  {
    number: '03',
    title: 'Enclosure & assembly',
    status: 'Ordered',
    description:
      'The enclosure, DIN rails, internal cable, fuse holders, DC connectors and PG7 glands are ordered for the first assembly. Cable fit, sealing and the outdoor route still need checking.',
  },
  {
    number: '04',
    title: 'Power first. Irrigation later.',
    status: 'Still to confirm',
    description:
      'The power supply and terminal blocks are not yet confirmed. Supply compatibility and the final fuse rating come before powering the assembly. A valve and automatic watering remain a later stage.',
  },
