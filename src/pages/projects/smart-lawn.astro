    opacity: 0.75;
  }
  .architecture-node {
    max-width: 300px;
    margin: auto;
    text-align: center;
  }
  .app-node {
    border-color: #39776c;
    font-weight: 700;
  }
  .flow-label {
    text-align: center;
    font: 11px/1.8 var(--note-font);
    margin: 10px 0;
  }
  .architecture-note {
    text-align: center;
    margin-bottom: 0;
  }
  .hardware-item {
    border-top: 1px solid color-mix(in srgb, currentColor 25%, transparent);
    padding-top: 14px;
  }
  .hardware-gallery {
