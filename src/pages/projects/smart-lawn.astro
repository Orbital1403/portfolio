    vendor: 'Solar DIY',
  },
  {
    image: 'internal-cable-reference.png',
    width: 582,
    height: 444,
    title: 'Internal wiring',
    detail: 'Flexible four-core hookup wire',
    alt: 'LEDsales reference photograph of flat four-core silicone hookup wire',
    source: 'https://www.ledsales.com.au/index.php?main_page=product_info&products_id=3046',
    vendor: 'LEDsales',
  },
  {
    image: 'inline-fuses-reference.jpg',
    width: 800,
    height: 800,
    title: 'Inline fuse holders',
    detail: 'Wired holders for glass fuses',
    alt: 'Tian Rui reference photograph of two inline glass-fuse holders with red wire leads',
    source:
      'https://www.fuse-china.com/sale-37945850-16awg-gauge-5x20mm-inline-glass-tube-fuse-holder-splash-proof-waterproof.html',
    vendor: 'Tian Rui',
  },
  {
    image: 'dc-connectors-reference.jpg',
    width: 970,
    height: 728,
    title: 'DC power connector',
    detail: 'Barrel plug with screw terminals',
    alt: 'Adafruit reference photograph of a DC barrel plug with green screw terminals',
    source: 'https://www.adafruit.com/product/369',
    vendor: 'Adafruit',
  },
  {
    image: 'cable-glands-reference.jpg',
    width: 1560,
    height: 1040,
    title: 'Cable entries',
    detail: 'PG7 gland with a sealing ring',
    alt: 'DFRobot reference photograph of a light-coloured PG7 cable gland with a sealing ring',
    source: 'https://www.dfrobot.com/product-2159.html',
    vendor: 'DFRobot',
  },
