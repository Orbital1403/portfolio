---
import { getEntry, render } from 'astro:content'
import '~/styles/video-player.css'
import LayoutDefault from '~/layouts/LayoutDefault.astro'
const milaPost = await getEntry('spec', 'mila')
if (!milaPost) throw new Error('No MILA post found')
const { Content } = await render(milaPost)
const sections = [
  ['from-frustration-to-a-project', 'The idea'],
  ['one-interface-for-everyday-listening', 'The app'],
  ['guide', 'Quick guide'],
  ['streaming', 'Streaming'],
  ['mobile', 'On your phone'],
  ['download', 'Status & availability'],
  ['my-role-and-how-i-work', 'Behind the app'],
  ['hardware--foundation', 'Test environment'],
]
---

<LayoutDefault
  title="MILA* — Audio Application for Raspberry Pi — Gordan Grgić"
  description="An audio application for local music, internet radio and streaming. Explore the interface, a quick guide and the status of MILA Pi 1.0."
  image="/images/projects/mila-varied/dead-can-dance-fullscreen.jpg"
  imageAlt="MILA full-screen Now Playing with Dead Can Dance album artwork"
  imageWidth={1600}
  imageHeight={883}
>
  <header class="page-heading mila-heading">
    <a class="back-link" href="/projects/">← All project notes</a><p class="folio-label">
      SOFTWARE + MUSIC / FIELD NOTES 01
    </p><div class="mila-title-row">
      <h1 id="mila">MILA*</h1><span class="mila-stable"><i aria-hidden="true"></i>Pi 1.0 · Stable private version</span>
    </div><p class="mila-deck">One interface for everyday listening.</p><p class="mila-intro">
      An audio application for your local music, internet radio and streaming. Developed on Raspberry Pi, controlled by
      touch or from your browser.
    </p><div class="mila-actions">
      <a href="#guide" data-no-swup>Explore the app ↓</a><a href="#download" data-no-swup>Status &amp; availability</a>
    </div>
  </header><figure class="project-figure">
    <img
      src="/images/projects/mila-varied/dead-can-dance-fullscreen.jpg"
      width="1600"
      height="883"
      alt="MILA full-screen Now Playing with Dead Can Dance album artwork"
      data-group="cover"
      tabindex="0"
      role="button"
      loading="eager"
    /><figcaption>Now Playing — full-screen album view · Captured from Raspberry Pi</figcaption>
  </figure>
  <nav slot="aside" class="page-contents" aria-label="On this page">
    <p>ON THIS PAGE</p>{
      sections.map(([id, label]) => (
        <a data-no-swup href={`#${id}`}>
          {label}
        </a>
      ))
    }
  </nav>
  <article class="prose"><Content /></article>
  <nav class="project-navigation" aria-label="Other projects">
    <a href="/projects/">← All projects</a><a href="/projects/grgagrow/">02 / grgaGrow →</a>
  </nav>
</LayoutDefault>
<script>
  import { initMilaVideo } from '~/lib/mila-video'

  initMilaVideo()
  document.addEventListener('astro:page-load', initMilaVideo)
</script>
<style>
  .mila-heading {
    margin-bottom: 24px;
  }
  .back-link {
    display: inline-block;
    margin-bottom: 24px;
    font: 11px var(--note-font);
  }
  .mila-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .mila-title-row h1 {
    font-size: clamp(56px, 8vw, 82px);
    line-height: 1.1;
    margin: 14px 0 10px;
  }
  .mila-stable {
    display: flex;
    align-items: center;
    gap: 8px;
    font: 11px/1.6 var(--note-font);
    color: var(--mila-accent, #39776c);
  }
  .mila-stable i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }
  .mila-deck {
    font-size: clamp(23px, 3vw, 30px);
    line-height: 1.3;
    margin: 0 0 16px;
    letter-spacing: -0.5px;
  }
  .mila-intro {
    max-width: 650px;
    line-height: 1.75;
    font-size: 16px;
    opacity: 0.85;
  }
  .mila-actions {
    display: flex;
    gap: 12px 24px;
    flex-wrap: wrap;
    margin: 22px 0 28px;
    font: 12px/1.5 var(--note-font);
  }
  .mila-actions a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 11px 16px;
    border: 1px solid currentColor;
    text-decoration: none;
  }
  .mila-actions a:first-child {
    background: #39776c;
    border-color: #39776c;
    color: white;
  }
  .mila-actions a:hover {
    opacity: 0.85;
  }
  :global(.mila-story) {
    --mila-accent: #39776c;
  }
  :global(html.dark .mila-story) {
    --mila-accent: #aed1c2;
  }
  :global(html.dark .mila-stable) {
    color: #aed1c2;
  }
  :global(.mila-section) {
    padding: 44px 0 0;
    margin-top: 44px;
    border-top: 1px solid color-mix(in srgb, currentColor 23%, transparent);
    scroll-margin-top: 30px;
  }
  :global(.mila-story .mila-kicker) {
    font: 11px/1.7 var(--note-font);
    letter-spacing: 1px;
    color: var(--mila-accent);
    margin: 0 0 14px;
  }
  :global(.mila-story h2) {
    font-size: clamp(29px, 4vw, 37px);
    line-height: 1.22;
    margin: 0 0 20px;
  }
  :global(.mila-story h3) {
    font: 700 17px/1.4 var(--body-font);
    letter-spacing: 0;
    margin: 0 0 12px;
  }
  :global(.mila-story p) {
    line-height: 1.8;
  }
  :global(.mila-features) {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    margin: 32px 0 8px;
  }
  :global(.mila-features p) {
    font-size: 14px;
    margin: 0;
  }
  :global(.mila-number) {
    display: block;
    font: 12px var(--note-font);
    color: var(--mila-accent);
    margin-bottom: 14px;
  }
  :global(.mila-video) {
    margin: 28px 0;
  }
  :global(.mila-video video) {
    display: block;
    width: 100%;
    height: auto;
    background: #1a242b;
  }
  :global(.mila-video figcaption) {
    font: 11px/1.7 var(--note-font);
    margin-top: 10px;
    opacity: 0.75;
  }
  :global(.mila-step) {
    border-bottom: 1px solid color-mix(in srgb, currentColor 22%, transparent);
    margin: 0 !important;
    padding: 0 !important;
  }
  :global(.mila-step summary) {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 20px;
    cursor: pointer;
    padding: 22px 0;
  }
  :global(.mila-step summary::-webkit-details-marker) {
    display: none;
  }
  :global(.mila-step summary .mila-number) {
    margin: 0;
  }
  :global(.mila-step summary strong) {
    display: block;
    font-size: 18px;
  }
  :global(.mila-step summary small) {
    display: block;
    font-size: 13px;
    opacity: 0.7;
    margin-top: 5px;
  }
  :global(.mila-plus) {
    margin-left: auto;
    font: 26px var(--note-font);
    transition: transform 0.15s;
  }
  :global(.mila-step[open] .mila-plus) {
    transform: rotate(45deg);
  }
  :global(.mila-step-body) {
    padding-bottom: 18px;
  }
  :global(.mila-step-body > p) {
    margin: 0 0 22px;
  }
  :global(.mila-story .mila-note) {
    font: 12px/1.8 var(--note-font);
    opacity: 0.72;
    margin-top: 24px;
  }
  :global(.project-figure) {
    margin: 24px 0;
  }
  :global(.project-figure img) {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    border: 1px solid color-mix(in srgb, currentColor 18%, transparent);
  }
  :global(.project-figure figcaption) {
    font: 11px/1.7 var(--note-font);
    opacity: 0.7;
    margin-top: 10px;
  }
  :global(.mila-mobile-layout) {
    display: grid;
    grid-template-columns: 1fr 240px;
    align-items: center;
    gap: 38px;
  }
  :global(.mila-phone) {
    max-width: 240px;
    margin: 0 auto !important;
  }
  :global(.mila-phone img) {
    border-radius: 16px;
    box-shadow: 0 12px 30px #0002;
  }
  :global(.mila-release) {
    padding: 30px;
    background: color-mix(in srgb, var(--mila-accent) 5%, transparent);
    border: 1px solid color-mix(in srgb, var(--mila-accent) 38%, transparent);
  }
  :global(.mila-release-heading) {
    display: flex;
    align-items: center;
    gap: 18px;
    justify-content: space-between;
  }
  :global(.mila-release-heading h2) {
    margin-bottom: 0;
  }
  :global(.mila-version) {
    font: 14px var(--note-font);
    white-space: nowrap;
    border: 1px solid currentColor;
    padding: 7px 10px;
    color: var(--mila-accent);
  }
  :global(.mila-release-data) {
    margin: 24px 0;
  }
  :global(.mila-release-data > div) {
    display: grid;
    grid-template-columns: 140px 1fr;
    align-items: center;
    gap: 20px;
    border-top: 1px solid color-mix(in srgb, currentColor 15%, transparent);
    padding: 12px 0;
  }
  :global(.mila-release-data dt) {
    font: 12px/1.8 var(--note-font);
    opacity: 0.7;
  }
  :global(.mila-release-data dd) {
    margin: 0;
    font-size: 14px;
    line-height: 1.7;
  }
  :global(.mila-download-state) {
    display: flex;
    gap: 18px;
    padding: 20px 0 0;
    border-top: 1px solid color-mix(in srgb, currentColor 20%, transparent);
  }
  :global(.mila-download-state > span) {
    font-size: 30px;
    color: var(--mila-accent);
  }
  :global(.mila-download-state p) {
    font-size: 13px;
    margin: 7px 0 0;
    opacity: 0.8;
  }
  :global(.mila-engineering) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    margin: 30px 0;
  }
  :global(.mila-engineering p) {
    font-size: 14px;
  }
  :global(.mila-platform) {
    padding: 24px 0;
    border-block: 1px solid color-mix(in srgb, currentColor 20%, transparent);
  }
  :global(.mila-hardware-gallery) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    align-items: start;
  }
  :global(.mila-hardware-gallery figure) {
    margin-top: 0;
  }
  :global(.mila-stack) {
    font: 12px/1.9 var(--note-font);
  }
  :global(.mila-text-link) {
    font: 13px var(--note-font);
  }
  .project-navigation {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: 50px;
    padding-top: 20px;
    border-top: 1px solid color-mix(in srgb, currentColor 20%, transparent);
    font: 12px/1.7 var(--note-font);
  }
  @media (max-width: 600px) {
    :global(.mila-hardware-gallery) {
      grid-template-columns: 1fr;
    }
    .mila-title-row {
      gap: 0;
    }
    .mila-title-row h1 {
      margin-bottom: 5px;
    }
    .mila-stable {
      margin: 0 0 16px;
    }
    .mila-deck {
      font-size: 24px;
    }
    :global(.mila-features) {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    :global(.mila-features > div) {
      padding-left: 34px;
      position: relative;
    }
    :global(.mila-features .mila-number) {
      position: absolute;
      left: 0;
      top: 3px;
    }
    :global(.mila-mobile-layout) {
      grid-template-columns: 1fr;
    }
    :global(.mila-phone) {
      max-width: 260px;
    }
    :global(.mila-release) {
      padding: 22px 18px;
    }
    :global(.mila-release-heading) {
      align-items: flex-start;
    }
    :global(.mila-release-data > div) {
      grid-template-columns: 1fr;
      gap: 3px;
    }
    :global(.mila-engineering) {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    :global(.mila-section) {
      padding-top: 30px;
      margin-top: 32px;
    }
  }

  :global(.mila-availability-layout) {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
    align-items: start;
  }
  :global(.mila-os-list) {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 24px;
  }
  :global(.mila-os-card) {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 14px;
    border: 1px solid color-mix(in srgb, currentColor 18%, transparent);
  }
  :global(.mila-os-card svg),
  :global(.mila-tech-card svg) {
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    color: var(--mila-accent);
  }
  :global(.mila-os-card strong),
  :global(.mila-os-card small),
  :global(.mila-tech-card strong),
  :global(.mila-tech-card small) {
    display: block;
  }
  :global(.mila-os-card small),
  :global(.mila-tech-card small) {
    font-size: 12px;
    line-height: 1.6;
    opacity: 0.75;
  }
  :global(.mila-tech-grid) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-top: 20px;
  }
  :global(.mila-tech-card) {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 14px;
    border-top: 1px solid color-mix(in srgb, currentColor 18%, transparent);
  }
  @media (max-width: 900px) {
    :global(.mila-availability-layout) {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 540px) {
    :global(.mila-tech-grid) {
      grid-template-columns: 1fr;
    }
  }

  :global(main .prose .mila-story h3) {
    font: 700 18px/1.4 var(--body-font);
    letter-spacing: 0;
    text-transform: none;
    margin: 0 0 10px;
  }
  :global(main .prose .mila-features > div) {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  :global(main .prose .mila-features .mila-number) {
    position: static;
    margin: 0;
    line-height: 1.4;
  }
  :global(main .prose .mila-features h3) {
    margin: 0;
  }
  :global(main .prose .mila-step summary) {
    padding: 18px 8px;
    gap: 16px;
    border-radius: 3px;
  }
  :global(main .prose .mila-step summary .mila-number) {
    margin: 0;
    flex: 0 0 24px;
  }
  :global(main .prose .mila-step summary:focus) {
    outline: none;
  }
  :global(main .prose .mila-step summary:focus-visible) {
    outline: 2px solid var(--mila-accent);
    outline-offset: 4px;
  }
  :global(main .prose .mila-step-body .project-figure:last-child) {
    margin-bottom: 12px;
  }
  @media (max-width: 650px) {
    :global(.mila-os-list) {
      grid-template-columns: 1fr;
    }
  }
</style>
