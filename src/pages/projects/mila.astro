---
import { getEntry, render } from 'astro:content'
import LayoutDefault from '~/layouts/LayoutDefault.astro'

const milaPost = await getEntry('spec', 'mila')
if (!milaPost) throw new Error('No MILA post found')
const { Content } = await render(milaPost)

const sections = [
  ['from-frustration-to-a-project', 'Idea'],
  ['one-interface-for-everyday-listening', 'Features'],
  ['my-role-and-how-i-work', 'My role'],
  ['development-example-keeping-favourites-consistent', 'Examples'],
  ['testing-and-releases', 'Testing'],
  ['hardware--foundation', 'Hardware'],
  ['current-state', 'Current state'],
]
---

<LayoutDefault
  title="MILA* — Audio Streamer in Development — Gordan Grgić"
  description="A working personal audio-streamer prototype. Requirements, troubleshooting, device testing and AI-assisted development, with further integration and recovery validation underway."
  image="/images/projects/gstreamer/mila-now-playing-20261018.jpg"
  imageAlt="MILA* audio streamer: Now Playing interface with album artwork, playback controls and separate source and DAC format labels"
  imageWidth={1024}
  imageHeight={600}
>
  <header class="page-heading">
    <a class="back-link" href="/projects/">← All project notes</a>
    <p class="folio-label">HARDWARE + SOFTWARE + MUSIC / FIELD NOTES 01</p>
    <h1>Audio streamer</h1>
  </header>
  <nav class="project-contents" aria-label="Project contents">
    {
      sections.map(([id, label]) => (
        <a data-no-swup href={`#${id}`}>
          {label}
        </a>
      ))
    }
  </nav>
  <nav slot="aside" class="page-contents" aria-label="On this page">
    <p>ON THIS PAGE</p>
    {
      sections.map(([id, label]) => (
        <a data-no-swup href={`#${id}`}>
          {label}
        </a>
      ))
    }
  </nav>
  <article class="prose">
    <Content />
  </article>
</LayoutDefault>

<style>
  .back-link {
    display: inline-block;
    margin-bottom: 24px;
    font:
      11px 'IBM Plex Mono',
      monospace;
  }
  .project-contents {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    padding: 14px 0;
    margin-bottom: 25px;
    border-top: 1px solid color-mix(in srgb, currentColor 20%, transparent);
    border-bottom: 1px solid color-mix(in srgb, currentColor 20%, transparent);
    font:
      11px 'IBM Plex Mono',
      monospace;
  }
  .project-contents a {
    color: inherit;
    text-decoration: none;
    padding: 4px 0;
  }
  .project-contents a:hover {
    color: #39776c;
    background: none;
  }
</style>
