---
const destination = `${import.meta.env.BASE_URL}projects/our-laundry/`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Our laundry — page moved</title>
    <link rel="canonical" href="https://gordangrgic.com/projects/our-laundry/" />
    <noscript><meta http-equiv="refresh" content={`0;url=${destination}`} /></noscript>
  </head>
  <body>
    <p>This project is now <a id="our-laundry-destination" href={destination}>Our laundry</a>.</p>
    <script is:inline>
      const destination = document.getElementById('our-laundry-destination').getAttribute('href')
      window.location.replace(destination + window.location.search + window.location.hash)
    </script>
  </body>
</html>
