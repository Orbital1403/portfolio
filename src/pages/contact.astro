---
import LayoutDefault from '~/layouts/LayoutDefault.astro'
import Icon from '~/components/Icon.astro'
const configured = import.meta.env.PUBLIC_CONTACT_FORM_ENDPOINT || 'https://formspree.io/f/xjygepdn'
const endpoint = /^https:\/\/formspree\.io\/f\/[a-zA-Z0-9]+$/.test(configured) ? configured : ''
---

<LayoutDefault
  title="Contact — Gordan Grgić"
  description="Get in touch with Gordan Grgić in Brussels about a role in quality, testing or technical support, a project, or MILA*."
>
  <section class="contact-page">
    <p class="folio-label">PERSONAL FIELD NOTES / CONTACT</p>
    <h1>Let's talk.</h1>
    <p class="contact-lead">Have a role in mind, a project to discuss or a question about MILA*? Leave me a message.</p>
    <form id="contactForm" method="POST" action={endpoint || undefined} data-endpoint={endpoint} novalidate>
      <div class="form-heading"><Icon name="mail" /><span>A direct conversation.</span></div>
      <div class="field-pair">
        <div class="field">
          <label for="contact-name">Your name</label><input
            id="contact-name"
            name="name"
            autocomplete="name"
            maxlength="100"
            required
            placeholder="How should I address you?"
          />
        </div><div class="field">
          <label for="contact-email">Your email</label><input
            id="contact-email"
            name="email"
            type="email"
            autocomplete="email"
            maxlength="254"
            required
            placeholder="Where I can reply"
          />
        </div>
      </div>
      <div class="field">
        <label for="contact-topic">What is it about? <span>Optional</span></label><select
          id="contact-topic"
          name="topic"
          ><option value="General enquiry">Choose a topic</option><option>Work opportunity</option><option
            >Project or collaboration</option
          ><option>MILA* audio streamer</option><option>Something else</option></select
        >
      </div>
      <div class="field">
        <label for="contact-message">Your message</label><textarea
          id="contact-message"
          name="message"
          rows="6"
          maxlength="3000"
          required
          placeholder="Tell me a little about what you have in mind..."></textarea><span
          class="message-count"
          id="message-count">0 / 3000</span
        >
      </div>
      <div class="honey" aria-hidden="true">
        <label>Leave this empty<input name="_gotcha" tabindex="-1" autocomplete="off" /></label>
      </div>
      <div class="form-bottom">
        <span class="reply-note">Leave an address where I can reply.</span><button
          type="submit"
          id="contact-submit"
          disabled={!endpoint}><span>Send message</span><Icon name="arrow" /></button
        >
      </div>
      <p id="contactStatus" role="status" aria-live="polite"></p>
      {
        !endpoint && (
          <p class="availability-note">
            Messaging will be available soon. In the meantime,{' '}
            <a href="https://www.linkedin.com/in/gordan-grgic-0ba40a354/" target="_blank" rel="noopener noreferrer">
              find me on LinkedIn ↗
            </a>
            .
          </p>
        )
      }
    </form>
    <div class="contact-location"><span>ZAGREB → BRUSSELS</span><span>Computers · Electronics · Music</span></div>
  </section>
</LayoutDefault>
<style>
  .contact-page {
    font-family: 'IBM Plex Mono', monospace;
    max-width: 720px;
  }
  .folio-label {
    font-size: 10px;
    letter-spacing: 1.5px;
    opacity: 0.6;
  }
  h1 {
    font-family: 'MyFont', monospace;
    font-weight: 400;
    font-size: 48px;
    line-height: 1.2;
    margin: 25px 0 16px;
  }
  .contact-lead {
    font-size: 13px;
    line-height: 1.9;
    max-width: 570px;
    margin-bottom: 30px;
  }
  form {
    border: 1px solid color-mix(in srgb, currentColor 25%, transparent);
    padding: 26px;
    background: color-mix(in srgb, var(--uno-colors-background) 94%, transparent);
  }
  .form-heading {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    border-bottom: 1px solid color-mix(in srgb, currentColor 20%, transparent);
    padding-bottom: 18px;
    margin-bottom: 25px;
  }
  .field-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 9px;
    margin-bottom: 22px;
  }
  label {
    font-size: 11px;
    font-weight: 700;
  }
  label span {
    font-weight: 400;
    opacity: 0.55;
    margin-left: 8px;
  }
  input,
  select,
  textarea {
    font:
      12px 'IBM Plex Mono',
      monospace;
    line-height: 1.7;
    padding: 12px;
    width: 100%;
    box-sizing: border-box;
    border: 1px solid color-mix(in srgb, currentColor 25%, transparent);
    border-radius: 0;
    color: inherit;
    background: var(--uno-colors-background);
    outline: none;
  }
  input:focus,
  select:focus,
  textarea:focus {
    border-color: #39776c;
    box-shadow: 0 0 0 2px #39776c22;
  }
  textarea {
    resize: vertical;
    min-height: 140px;
  }
  input::placeholder,
  textarea::placeholder {
    opacity: 0.6;
    color: inherit;
  }
  .message-count {
    font-size: 9px;
    align-self: flex-end;
    opacity: 0.55;
  }
  .form-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
  }
  .reply-note {
    font-size: 10px;
    opacity: 0.65;
    max-width: 190px;
    line-height: 1.7;
  }
  button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    font:
      11px 'IBM Plex Mono',
      monospace;
    padding: 13px 17px;
    background: #26333b;
    color: #fff;
    border: 1px solid #26333b;
    cursor: pointer;
  }
  button:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
  button:focus-visible {
    outline: 2px solid #39776c;
    outline-offset: 4px;
  }
  .availability-note,
  #contactStatus {
    font-size: 11px;
    line-height: 1.8;
    margin: 18px 0 0;
  }
  .availability-note {
    opacity: 0.7;
  }
  #contactStatus:empty {
    display: none;
  }
  .contact-location {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 9px;
    letter-spacing: 1px;
    opacity: 0.6;
    line-height: 1.8;
    margin: 20px 0;
  }
  .honey {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  @media (max-width: 600px) {
    h1 {
      font-size: 40px;
    }
    form {
      padding: 20px;
    }
    .field-pair {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .contact-location {
      flex-direction: column;
    }
  }
</style>
<script is:inline>
  ;(() => {
    function init() {
      const form = document.getElementById('contactForm')
      if (!form || form.dataset.bound) {
        return
      }
      form.dataset.bound = '1'
      const status = document.getElementById('contactStatus')
      const button = document.getElementById('contact-submit')
      const message = document.getElementById('contact-message')
      const count = document.getElementById('message-count')
      message.addEventListener('input', () => {
        count.textContent = `${message.value.length} / 3000`
      })
      let busy = false
      form.addEventListener('submit', async (e) => {
        e.preventDefault()
        if (busy) {
          return
        }
        if (!form.reportValidity()) {
          return
        }
        if (!message.value.trim() || !document.getElementById('contact-name').value.trim()) {
          status.textContent = 'Please add your name and a message.'
          return
        }
        const endpoint = form.dataset.endpoint
        if (!endpoint) {
          status.textContent = 'Messaging is not available yet.'
          return
        }
        const body = new FormData(form)
        busy = true
        button.disabled = true
        button.querySelector('span').textContent = 'Sending...'
        status.textContent = ''
        const controller = new AbortController()
        const timer = setTimeout(() => controller.abort(), 15000)
        try {
          const response = await fetch(endpoint, {
            method: 'POST',
            body,
            headers: { Accept: 'application/json' },
            signal: controller.signal,
          })
          const data = await response.json().catch(() => null)
          if (!response.ok || !data || data.ok !== true) {
            throw new Error('Please check your details and try again.')
          }
          status.textContent = 'Thank you. Your message has been submitted.'
          form.reset()
          count.textContent = '0 / 3000'
        } catch (error) {
          const errorMessage =
            error.name === 'AbortError'
              ? 'Delivery could not be confirmed. Please check before sending again.'
              : 'Your message could not be submitted. Your text is still here; please try again later.'
          status.textContent = errorMessage
        } finally {
          clearTimeout(timer)
          busy = false
          button.disabled = false
          button.querySelector('span').textContent = 'Send message'
        }
      })
    }
    init()
    document.addEventListener('astro:page-load', init)
  })()
</script>
