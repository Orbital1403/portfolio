---
import LayoutDefault from '~/layouts/LayoutDefault.astro'
import { getCollection } from 'astro:content'
import { formatDate } from '~/utils'
import { toSlug } from '~/utils/slug'

/** Encode svakog segmenta putanje (space, & itd.) */
const esc = (p?: string) => {
  if (!p) return ''
  const lead = p.startsWith('/')
  const parts = p
    .split('/')
    .filter(Boolean)
    .map((s) => encodeURIComponent(decodeURIComponent(s)))
  return (lead ? '/' : '') + parts.join('/')
}

const entries = await getCollection('hobbies')
entries.sort((a, b) => {
  const da = a.data.date ? new Date(a.data.date as unknown as string).getTime() : 0
  const db = b.data.date ? new Date(b.data.date as unknown as string).getTime() : 0
  return db - da
})
---

<LayoutDefault>
  <section class="max-w-6xl mx-auto">
    <h1 class="text-2xl font-700 mb-1">Hobbies</h1>
    <p class="text-slate6 mb-6">My hobbies and DIY projects.</p>

    {
      entries.length === 0 ? (
        <p class="text-slate6">Nothing here yet. Time to build something! 🔧</p>
      ) : (
        <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {entries.map((entry) => {
            const href = `/hobbies/${toSlug(entry.id)}/`
            const cover = entry.data.cover
            const title = entry.data.title
            const summary = entry.data.summary
            const date = entry.data.date ? formatDate(entry.data.date) : null
            const tags = entry.data.tags ?? []

            return (
              <li>
                <a
                  href={href}
                  class="group block rounded-xl border border-slate3 bg-white/70 dark:bg-slate-900/50 shadow-md
           transition-all duration-300 ease-out
           hover:-translate-y-0.5 hover:scale-[1.02] hover:shadow-lg
           focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-sky-400
           focus-visible:-translate-y-0.5 focus-visible:scale-[1.02] focus-visible:shadow-lg"
                >
                  <figure class="overflow-hidden rounded-t-xl">
                    {cover ? (
                      <img
                        src={esc(cover)}
                        alt={`${title} cover`}
                        loading="lazy"
                        class="w-full aspect-[4/3] object-cover
                 transition-transform duration-300 ease-out will-change-transform
                 group-hover:scale-105 group-focus-visible:scale-105"
                      />
                    ) : (
                      <div class="w-full aspect-[4/3] flex items-center justify-center bg-slate2 text-slate7">
                        <span class="text-3xl">🧰</span>
                      </div>
                    )}
                  </figure>

                  <div class="p-4">
                    <h2 class="text-lg font-700 mb-1">{title}</h2>

                    {(date || tags.length) && (
                      <div class="text-xs text-slate6 mb-2">
                        {date && <span>Posted at {date}</span>}
                        {date && tags.length ? <span> · </span> : null}
                        {tags.length ? <span>{tags.join(', ')}</span> : null}
                      </div>
                    )}

                    {summary && <p class="text-sm text-slate7 line-clamp-3">{summary}</p>}

                    {tags.length > 0 && (
                      <div class="mt-3 flex flex-wrap gap-2">
                        {tags.map((t) => (
                          <span class="text-2.5 px-2 py-1 rounded border border-slate3 text-slate7 bg-slate1">{t}</span>
                        ))}
                      </div>
                    )}
                  </div>
                </a>
              </li>
            )
          })}
        </ul>
      )
    }
  </section>
</LayoutDefault>
