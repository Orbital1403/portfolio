---
interface Props {
  id: string
  items: { label: string; text: string }[]
}

const { id, items } = Astro.props
---

<section class="project-overview" aria-labelledby={`${id}-overview-title`}>
  <h2 id={`${id}-overview-title`}>At a glance</h2>
  <dl>
    {items.map(({ label, text }) => (
      <div>
        <dt>{label}</dt>
        <dd>{text}</dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .project-overview {
    box-sizing: border-box;
    margin: 28px 0 36px;
    padding: 22px;
    border: 1px solid color-mix(in srgb, currentColor 22%, transparent);
    background: color-mix(in srgb, #39776c 4%, transparent);
    font-family: var(--body-font);
    overflow-wrap: anywhere;
  }
  h2 {
    margin: 0 0 20px;
    font: 400 26px/1.3 'MyFont', monospace;
  }
  dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 28px;
    margin: 0;
  }
  dl > div { min-width: 0; }
  dt {
    margin-bottom: 6px;
    color: var(--note-color);
    font: 600 12px/1.6 var(--note-font);
  }
  dd {
    margin: 0;
    font-size: 15px;
    line-height: 1.7;
  }
  @media (max-width: 600px) {
    .project-overview { padding: 18px; }
    dl { grid-template-columns: minmax(0, 1fr); gap: 18px; }
  }
</style>
