---
import Icon from '~/components/Icon.astro'
---

<a class="planned-project" href="/projects/grgagrow/">
  <img
    src="/images/projects/smart-lawn/lawn-800.jpg"
    alt="My lawn, the future test site for the grgaGrow soil-monitoring system"
    width="800"
    height="600"
    loading="lazy"
    decoding="async"
  />
  <div class="planned-copy">
    <p class="planned-label">SOIL MONITORING / CLOUD APPLICATION</p>
    <div class="planned-heading">
      <h2>grgaGrow</h2><span>In development</span>
    </div>
    <p>
      grgaGrow combines soil history and weekly reports with regional weather and a sun/shade model. A private cloud
      workspace adds a garden journal, alerts and guided sensor setup. Explore Demo or public Live while physical sensor
      integration is still ahead.
    </p>
    <span class="planned-link">Explore the project <Icon name="arrow" /></span>
  </div>
</a>
<style>
  .planned-project {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    border: 1px solid color-mix(in srgb, currentColor 25%, transparent);
    color: inherit;
    text-decoration: none !important;
    margin: 28px 0 42px;
    font-family: var(--note-font, 'IBM Plex Mono', monospace);
  }
  .planned-project:hover {
    color: inherit !important;
    background: color-mix(in srgb, #39776c 4%, transparent) !important;
    border-color: #39776c;
  }
  .planned-project img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    min-height: 220px;
  }
  .planned-copy {
    padding: 22px;
  }
  .planned-label {
    font-size: 10px;
    letter-spacing: 1.2px;
    opacity: 0.7;
    margin: 0 0 12px;
  }
  .planned-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  .planned-heading h2 {
    font-size: 24px;
    margin: 0;
  }
  .planned-heading span {
    font-size: 10px;
    border: 1px solid currentColor;
    padding: 5px 8px;
  }
  .planned-copy > p:not(.planned-label) {
    font-size: 13px;
    line-height: 1.8;
  }
  .planned-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
    margin-top: 18px;
  }
  .planned-project:focus-visible {
    outline: 2px solid #39776c;
    outline-offset: 4px;
  }
  @media (max-width: 600px) {
    .planned-project {
      grid-template-columns: 1fr;
    }
    .planned-project img {
      height: auto;
      aspect-ratio: 4/3;
    }
  }
</style>
