---
const quantityLabels = ['Temperature', 'Moisture channel', 'pH']
const soil = ['22.6 °C', '19.4 %', '6.5']
const readings = [
  {
    label: 'In water',
    image: '/images/projects/smart-lawn/bench/thp-in-water.webp',
    alt: 'Illustration of a probe in a glass of water',
    values: ['21.5 °C', '100.0 %', '4.5'],
  },
  {
    label: 'First reading in a pot',
    image: '/images/projects/smart-lawn/bench/thp-in-pot.webp',
    alt: 'Illustration of a probe in potting soil',
    values: soil,
  },
]
const steps = [
  ['Terminal request', 'The computer asks the ESP32 for a reading.'],
  ['Probe response', 'The ESP32 sends a Modbus request over RS485 and waits for the THP probe to respond.'],
  ['Message checks', 'The firmware checks the address, function, length and checksum (CRC).'],
  ['Readout', 'Values from a valid response appear in the terminal.'],
]
---

<div class="bench-results">
  <section aria-labelledby="bench-readings">
    <h4 id="bench-readings">THP bench readings</h4>
    <div class="reading-grid">
      {
        readings.map(({ label, image, alt, values }) => (
          <figure class="reading-card">
            <img class="probe-sketch" src={image} width="330" height="330" alt={alt} loading="lazy" decoding="async" />
            <figcaption>
              <h5>{label}</h5>
              <dl class="reading-values">
                {values.map((value, n) => (
                  <div>
                    <dt>{quantityLabels[n]}</dt>
                    <dd>{value}</dd>
                  </div>
                ))}
              </dl>
            </figcaption>
          </figure>
        ))
      }
    </div>
    <p class="bench-note">The THP probe was tested on its own, first in water and then in moist soil in a pot.</p>
  </section>

  <section aria-labelledby="bench-wiring">
    <h4 id="bench-wiring">Bench connections</h4>
    <div class="bench-connection">
      <div class="bench-node"><strong>THP probe</strong><small>Temperature, moisture and pH</small></div>
      <div class="connection-label">RS485 <span aria-hidden="true">↔</span></div>
      <div class="bench-node"><strong>ESP32-S3</strong><small>Diagnostic firmware</small></div>
      <div class="connection-label">USB <span aria-hidden="true">↔</span></div>
      <div class="bench-node"><strong>Computer</strong><small>Readings in the terminal</small></div>
    </div>
    <div class="connection-notes">
      <p><strong>Bench power</strong><br />A separate 12 V adapter powers the THP probe.</p>
      <p>
        <strong>ESP32-S3 → Wi-Fi → cloud</strong><br />In a later test the controller ran on 12 V with USB unplugged.
        The cloud acknowledged its first bench samples; they are test data, not a live feed.
      </p>
    </div>
  </section>

  <section aria-labelledby="bench-reading-flow">
    <h4 id="bench-reading-flow">From request to readout</h4>
    <ol class="reading-flow">
      {
        steps.map(([title, description]) => (
          <li>
            <>
              <strong>{title}</strong>
              <small>{description}</small>
            </>
          </li>
        ))
      }
    </ol>
    <div class="reading-grid">
      <div class="flow-result">
        <h5>Example from soil</h5>
        <dl class="reading-values">
          {
            soil.map((value, n) => (
              <div>
                <>
                  <dt>{quantityLabels[n]}</dt>
                  <dd>{value}</dd>
                </>
              </div>
            ))
          }
        </dl>
      </div>
      <div class="flow-result">
        <h5>If no response arrives</h5>
        <p>The firmware reports a timeout. That request produces no new reading.</p>
      </div>
    </div>
    <slot name="code" />
  </section>

  <section aria-labelledby="bench-firmware">
    <h4 id="bench-firmware">Two firmware builds, one shared test</h4>
    <div class="firmware-merge">
      <div class="bench-node">
        <strong>TH firmware</strong><small>Temperature and moisture<br />Probe response confirmed on the bench</small>
      </div>
      <div class="bench-node">
        <strong>THP firmware</strong><small>Temperature, moisture and pH<br />Readings in water and soil</small>
      </div>
      <div class="connection-label merge-arrow" aria-hidden="true">↘ &nbsp; ↙</div>
      <div class="bench-node">
        <strong>Joint diagnostic firmware</strong>
        <small
          >Two probes on one RS485 bus, with separate readings for each.<br />Both probes responded in air during the
          joint bench test, each at its own address.</small
        >
      </div>
    </div>
  </section>
</div>

<style>
  .bench-results {
    --bench-border: color-mix(in srgb, currentColor 25%, transparent);
    --bench-tint: color-mix(in srgb, #39776c 6%, transparent);
    margin: 26px 0;
  }
  .bench-results section {
    padding: 18px 0;
    border-top: 1px solid var(--bench-border);
  }
  h4 {
    margin: 0 0 12px;
    font: 600 20px/1.35 var(--body-font);
  }
  h5 {
    margin: 0 0 8px;
    font: 600 16px/1.35 var(--body-font);
  }
  .reading-grid,
  .connection-notes,
  .firmware-merge {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .reading-card,
  .bench-node,
  .flow-result {
    min-width: 0;
    margin: 0;
    padding: 12px;
    border: 1px solid var(--bench-border);
    background: var(--bench-tint);
  }
  .reading-card,
  .bench-node {
    text-align: center;
  }
  .probe-sketch {
    display: block;
    width: min(100%, 168px);
    height: auto;
    margin: 0 auto 8px;
  }
  :global(html.dark) .probe-sketch {
    filter: invert(1) hue-rotate(180deg);
  }
  figcaption {
    margin: 0;
  }
  .reading-values {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 4px;
    margin: 0;
    padding-top: 8px;
    border-top: 1px solid var(--bench-border);
    text-align: center;
  }
  .reading-values div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 3px;
  }
  dt {
    font: 12px/1.35 var(--body-font);
  }
  dd {
    margin: 0;
    font: 15px/1.35 var(--note-font);
    white-space: nowrap;
  }
  .bench-note {
    margin: 10px 0 0;
    font: 12px/1.6 var(--note-font);
  }
  .bench-note a {
    text-underline-offset: 3px;
  }
  .bench-connection {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr);
    gap: 6px;
  }
  .connection-label {
    display: grid;
    place-content: center;
    justify-items: center;
    font: 11px/1.3 var(--note-font);
  }
  .connection-label span,
  .merge-arrow {
    font-size: 20px;
  }
  .bench-node strong,
  .bench-node small,
  .reading-flow strong,
  .reading-flow small {
    display: block;
  }
  small {
    font-size: 13px;
    line-height: 1.4;
  }
  .connection-notes {
    margin-top: 12px;
  }
  .connection-notes p {
    margin: 0;
    padding: 8px 10px;
    background: var(--bench-tint);
    border-left: 2px solid #39776c;
    font-size: 13px;
  }
  .reading-flow {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    padding: 0;
    margin: 0 0 12px;
    list-style: none;
    counter-reset: reading-step;
  }
  .reading-flow li {
    counter-increment: reading-step;
    padding: 8px;
    border-top: 2px solid #39776c;
    background: var(--bench-tint);
  }
  .reading-flow li::before {
    content: counter(reading-step, decimal-leading-zero);
    font: 12px/1.5 var(--note-font);
  }
  .flow-result p {
    margin: 0;
    font-size: 14px;
  }
  .merge-arrow,
  .firmware-merge > :last-child {
    grid-column: 1 / -1;
  }
  @media (max-width: 600px) {
    .probe-sketch {
      position: relative;
      width: min(100%, 212px);
      aspect-ratio: auto;
      height: 150px;
      margin-bottom: 4px;
    }
    .probe-sketch img {
      position: absolute;
      top: 50%;
      left: 0;
      translate: 0 -50%;
    }
    .reading-grid,
    .connection-notes,
    .bench-connection {
      grid-template-columns: 1fr;
    }
    .bench-connection .connection-label {
      grid-auto-flow: column;
      align-items: center;
      gap: 5px;
    }
    .bench-connection .connection-label span {
      transform: rotate(90deg);
    }
    .reading-flow {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
