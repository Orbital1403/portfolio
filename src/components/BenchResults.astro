---
import Icon from '~/components/Icon.astro'
import DisclosureSummary from '~/components/DisclosureSummary.astro'
import growIcons from '~/assets/grgagrow-icons.svg?url&no-inline'
import { growProbes } from '~/data/grgagrow-probes'

const quantityLabels = ['Temperature', 'Moisture channel', 'pH']
const soil = ['22.6 °C', '19.4 %', '6.5']
const readings = [
  {
    label: 'In water',
    image: '/images/projects/smart-lawn/bench/thp-in-water.webp',
    alt: 'Illustration of a probe in a glass of water',
    values: ['21.5 °C', '100.0 %', '4.5'],
  },
  {
    label: 'First reading in a pot',
    image: '/images/projects/smart-lawn/bench/thp-in-pot.webp',
    alt: 'Illustration of a probe in potting soil',
    values: soil,
  },
]
const steps = [
  {
    title: 'Terminal request',
    description: 'The computer asks the ESP32 for a reading.',
    icon: 'request',
  },
  {
    title: 'Probe response',
    description: 'The ESP32 sends a Modbus request over RS485 and waits for the THP probe to respond.',
    icon: 'probe-thp',
  },
  {
    title: 'Message checks',
    description: 'The firmware checks the address, function, length and checksum (CRC).',
    icon: 'validate',
  },
  {
    title: 'Readout',
    description: 'Values from a valid response appear in the terminal.',
    icon: 'readout',
  },
]
---

<div class="bench-results">
  <section class="data-path" aria-labelledby="bench-firmware">
    <h4 id="bench-firmware">From probes to app</h4>
    <figure class="data-path-diagram">
      <ul class="data-probes" role="list">
        {
          growProbes.map((probe) => (
            <li class:list={['data-probe', { 'data-probe-thp': probe.icon === 'probe-thp' }]}>
              <strong>{probe.icon === 'probe-thp' ? 'THP' : 'TH'}</strong>
              <div class="data-metrics">
                <span><Icon name="droplet" class="metric-icon" /><span>Moisture</span></span>
                <span><Icon sprite={growIcons} name="temperature" class="metric-icon" /><span>Temperature</span></span>
                {probe.icon === 'probe-thp' && <span class="data-ph">pH</span>}
              </div>
            </li>
          ))
        }
      </ul>
      <div class="data-bus"><span>RS485 / Modbus RTU</span></div>
      <ol class="data-stages" role="list">
        <li>
          <div class="data-node">
            <Icon sprite={growIcons} name="firmware" class="data-icon" />
            <strong>ESP32-S3 controller</strong>
          </div>
        </li>
        <li>
          <span class="data-hop">Wi-Fi / HTTPS</span>
          <div class="data-node">
            <Icon name="database" class="data-icon" />
            <div>
              <strong>PostgreSQL</strong>
              <small>Supabase · Reading storage</small>
            </div>
          </div>
        </li>
        <li>
          <span class="data-hop">Authenticated access</span>
          <div class="data-node data-app">
            <Icon name="web" class="data-icon" />
            <strong>grgaGrow / My Garden</strong>
          </div>
        </li>
      </ol>
      <figcaption class="bench-note">On the bench, the ESP32 read both probes and the cloud acknowledged the uploads.</figcaption>
    </figure>
    <details class="data-details">
      <DisclosureSummary icon="bench-meter">Bench test details</DisclosureSummary>
      <dl>
        <div>
          <dt>TH firmware</dt>
          <dd>Probe response confirmed on the bench</dd>
        </div>
        <div>
          <dt>THP firmware</dt>
          <dd>Readings in water and soil</dd>
        </div>
        <div>
          <dt>Joint diagnostic firmware</dt>
          <dd>Both probes responded in air on the same RS485 bus. The TH probe used address 03 and the THP probe used address 02, with separate readings for each.</dd>
        </div>
        <div>
          <dt>RS485 cable</dt>
          <dd>BITNER LP0170</dd>
        </div>
      </dl>
    </details>
  </section>
  <details class="data-details">
    <DisclosureSummary icon="connector">Bench wiring and sample readings</DisclosureSummary>
    <section aria-labelledby="bench-readings">
      <h4 id="bench-readings" class="probe-heading">
        <Icon sprite={growIcons} name="probe-thp" class="grow-probe probe-thp" />
        THP bench readings
      </h4>
      <div class="reading-grid">
        {
          readings.map(({ label, image, alt, values }) => (
            <figure class="reading-card">
              <img class="probe-sketch" src={image} width="330" height="330" alt={alt} loading="lazy" decoding="async" />
              <figcaption>
                <h5>{label}</h5>
                <dl class="reading-values">
                  {values.map((value, n) => (
                    <div>
                      <dt>{quantityLabels[n]}</dt>
                      <dd>{value}</dd>
                    </div>
                  ))}
                </dl>
              </figcaption>
            </figure>
          ))
        }
      </div>
      <p class="bench-note">The THP probe was tested on its own, first in water and then in moist soil in a pot.</p>
    </section>

    <section aria-labelledby="bench-wiring">
      <h4 id="bench-wiring">Bench connections</h4>
      <div class="bench-connection">
        <div class="bench-node"><strong>THP probe</strong><small>Temperature, moisture and pH</small></div>
        <div class="connection-label">RS485 <span aria-hidden="true">↔</span></div>
        <div class="bench-node"><strong>ESP32-S3</strong><small>Diagnostic firmware</small></div>
        <div class="connection-label">USB <span aria-hidden="true">↔</span></div>
        <div class="bench-node"><strong>Computer</strong><small>Readings in the terminal</small></div>
      </div>
      <div class="connection-notes">
        <p><strong>Bench power</strong><br />A separate 12 V adapter powers the THP probe.</p>
        <p>
          <strong>ESP32-S3 → Wi-Fi → cloud</strong><br />In a later test the controller ran on 12 V with USB unplugged.
          The cloud acknowledged its first bench samples; they are test data, not a live feed.
        </p>
      </div>
    </section>

    <section aria-labelledby="bench-reading-flow">
      <h4 id="bench-reading-flow">From request to readout</h4>
      <ol class="reading-flow" role="list">
        {
          steps.map(({ title, description, icon }, index) => (
            <li>
              <div class="reading-flow-mark" aria-hidden="true">
                <span>{String(index + 1).padStart(2, '0')}</span>
                <Icon sprite={growIcons} name={icon} class={icon === 'probe-thp' ? 'grow-probe probe-thp' : ''} />
              </div>
              <strong>{title}</strong>
              <small>{description}</small>
            </li>
          ))
        }
      </ol>
      <div class="reading-grid">
        <div class="flow-result">
          <h5>Example from soil</h5>
          <dl class="reading-values">
            {
              soil.map((value, n) => (
                <div>
                  <>
                    <dt>{quantityLabels[n]}</dt>
                    <dd>{value}</dd>
                  </>
                </div>
              ))
            }
          </dl>
        </div>
        <div class="flow-result">
          <h5>If no response arrives</h5>
          <p>The firmware reports a timeout. That request produces no new reading.</p>
        </div>
      </div>
      <slot name="code" />
    </section>
  </details>
</div>

<style>
  .bench-results {
    --bench-border: color-mix(in srgb, currentColor 25%, transparent);
    --bench-tint: color-mix(in srgb, #39776c 6%, transparent);
    margin: 26px 0;
  }
  .bench-results section {
    padding: 18px 0;
    border-top: 1px solid var(--bench-border);
  }
  h4 {
    margin: 0 0 12px;
    font: 600 20px/1.35 var(--body-font);
  }
  h5 {
    margin: 0 0 8px;
    font: 600 16px/1.35 var(--body-font);
  }
  .reading-grid,
  .connection-notes {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .reading-card,
  .bench-node,
  .flow-result {
    min-width: 0;
    margin: 0;
    padding: 12px;
    border: 1px solid var(--bench-border);
    background: var(--bench-tint);
  }
  .reading-card,
  .bench-node {
    text-align: center;
  }
  .probe-sketch {
    display: block;
    width: min(100%, 168px);
    height: auto;
    margin: 0 auto 8px;
  }
  :global(html.dark) .probe-sketch {
    filter: invert(1) hue-rotate(180deg);
  }
  figcaption {
    margin: 0;
  }
  .reading-values {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 4px;
    margin: 0;
    padding-top: 8px;
    border-top: 1px solid var(--bench-border);
    text-align: center;
  }
  .reading-values div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 3px;
  }
  dt {
    font: 12px/1.35 var(--body-font);
  }
  dd {
    margin: 0;
    font: 15px/1.35 var(--note-font);
  }
  .reading-values dd {
    white-space: nowrap;
  }
  .probe-heading {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .bench-note {
    margin: 10px 0 0;
    font: 12px/1.6 var(--note-font);
  }
  .bench-note a {
    text-underline-offset: 3px;
  }
  .bench-connection {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto minmax(0, 1fr);
    gap: 6px;
  }
  .connection-label {
    display: grid;
    place-content: center;
    justify-items: center;
    font: 11px/1.3 var(--note-font);
  }
  .connection-label span {
    font-size: 20px;
  }
  .bench-node strong,
  .bench-node small,
  .reading-flow strong,
  .reading-flow small {
    display: block;
  }
  small {
    font-size: 13px;
    line-height: 1.4;
  }
  .connection-notes {
    margin-top: 12px;
  }
  .connection-notes p {
    margin: 0;
    padding: 8px 10px;
    background: var(--bench-tint);
    border-left: 2px solid #39776c;
    font-size: 13px;
  }
  .reading-flow {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    padding: 0;
    margin: 0 0 12px;
    list-style: none;
  }
  .reading-flow li {
    padding: 8px;
    border-top: 2px solid #39776c;
    background: var(--bench-tint);
  }
  .reading-flow-mark {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
    font: 12px/1.5 var(--note-font);
  }
  .reading-flow-mark :global(.technical-icon) {
    width: 22px;
    height: 22px;
    flex: none;
    color: var(--grow-accent);
  }
  .flow-result p {
    margin: 0;
    font-size: 14px;
  }
  .data-path {
    --data-line: var(--grow-accent, #39776c);
  }
  .data-path-diagram {
    container-type: inline-size;
    margin: 0;
    padding: 16px;
    border: 1px solid var(--bench-border);
    border-radius: 10px;
    background: var(--bench-tint);
  }
  .data-probes,
  .data-stages {
    display: grid;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .data-probes {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .data-probe,
  .data-node {
    min-width: 0;
    padding: 10px 12px;
    border: 1px solid var(--bench-border);
    border-radius: 7px;
    font: 14px/1.35 var(--body-font, sans-serif);
    overflow-wrap: anywhere;
  }
  .data-probe {
    position: relative;
    border-block-start: 2px solid var(--grow-th, var(--data-line));
  }
  .data-probe-thp {
    border-block-start-color: var(--grow-thp, var(--data-line));
  }
  .data-metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 5px 10px;
    margin-top: 5px;
    font-size: 12px;
  }
  .data-metrics > span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .data-metrics :global(.metric-icon) {
    width: 15px;
    height: 15px;
    flex: none;
    color: var(--data-line);
  }
  .data-ph {
    padding-inline: 5px;
    border: 1px solid var(--bench-border);
    border-radius: 4px;
    color: var(--grow-thp-text, var(--data-line));
  }
  .data-probe::after,
  .data-bus::before,
  .data-bus::after {
    position: absolute;
    content: "";
    border-color: var(--data-line);
  }
  .data-probe::after {
    top: 100%;
    left: 50%;
    height: 8px;
    border-left: 1px solid var(--data-line);
  }
  .data-bus {
    position: relative;
    padding: 14px 0 11px;
    text-align: center;
    font: 12px/1.5 var(--note-font);
  }
  .data-bus::before {
    top: 8px;
    left: calc(25% - 3px);
    right: calc(25% - 3px);
    border-top: 1px solid var(--data-line);
  }
  .data-bus::after {
    bottom: 0;
    left: 50%;
    height: 8px;
    border-left: 1px solid var(--data-line);
  }
  .data-node {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .data-node :global(.data-icon) {
    width: 22px;
    height: 22px;
    flex: none;
    color: var(--data-line);
  }
  .data-node small {
    display: block;
    margin-top: 3px;
    font-size: 12px;
  }
  .data-app {
    border-color: var(--data-line);
  }
  .data-hop {
    display: block;
    padding: 5px 0;
    text-align: center;
    font: 11px/1.4 var(--note-font);
  }
  .data-hop::after {
    display: inline-block;
    width: 5px;
    height: 5px;
    margin-left: 6px;
    border-right: 1px solid var(--data-line);
    border-bottom: 1px solid var(--data-line);
    transform: rotate(45deg) translateY(-2px);
    content: "";
  }
  .data-path-diagram figcaption {
    color: var(--data-line);
  }
  .data-details {
    margin-top: 10px;
    border-block: 1px solid var(--bench-border);
  }
  .data-details > dl {
    display: grid;
    gap: 8px;
    margin: 0 0 12px;
  }
  .data-details > dl > div {
    display: grid;
    grid-template-columns: minmax(125px, 1fr) minmax(0, 3fr);
    gap: 8px;
  }
  .data-details > dl dt,
  .data-details > dl dd {
    margin: 0;
    font: 13px/1.5 var(--body-font, sans-serif);
  }
  .data-details > dl dt {
    font-weight: 600;
  }
  @container (min-width: 590px) {
    .data-bus::after {
      left: calc((100% - 44px) / 6);
      width: calc((100% + 22px) / 3);
      border-top: 1px solid var(--data-line);
      border-right: 1px solid var(--data-line);
    }
    .data-stages {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 22px;
    }
    .data-stages > li {
      display: flex;
      flex-direction: column;
      position: relative;
      min-width: 0;
    }
    .data-stages > li:first-child {
      padding-top: 25px;
    }
    .data-stages > li:first-child::before {
      position: absolute;
      top: 0;
      left: 50%;
      height: 25px;
      border-left: 1px solid var(--data-line);
      content: "";
    }
    .data-stages .data-node {
      flex: 1;
    }
    .data-hop::after {
      position: absolute;
      top: calc(50% + 11px);
      left: -16px;
      margin: 0;
      transform: rotate(-45deg);
    }
  }
  @media (max-width: 600px) {
    .probe-sketch {
      position: relative;
      width: min(100%, 212px);
      aspect-ratio: auto;
      height: 150px;
      margin-bottom: 4px;
    }
    .probe-sketch img {
      position: absolute;
      top: 50%;
      left: 0;
      translate: 0 -50%;
    }
    .reading-grid,
    .connection-notes,
    .bench-connection {
      grid-template-columns: 1fr;
    }
    .bench-connection .connection-label {
      grid-auto-flow: column;
      align-items: center;
      gap: 5px;
    }
    .bench-connection .connection-label span {
      transform: rotate(90deg);
    }
    .reading-flow {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
