---
/**
 * Swiper Web Components – radi bez framework plugina
 * https://swiperjs.com/element
 */
import 'swiper/element/bundle'

interface ImgItem {
  src: string
  alt?: string
}
interface Props {
  images: ImgItem[]
  autoplay?: boolean
}

// ako autoplay ne koristiš → makni ga ili ga prefiksi s "_"
const { images = [], autoplay: _autoplay = true } = Astro.props as Props
---

<swiper-container
  class="rounded-xl overflow-hidden shadow-md block"
  slides-per-view="1"
  space-between="16"
  loop="true"
  navigation="true"
  pagination="true"
  auto-height="true"
>
  {
    images.map((img) => (
      <swiper-slide>
        <img src={img.src} alt={img.alt ?? ''} loading="lazy" class="w-full h-64 sm:h-72 lg:h-80 object-cover" />
      </swiper-slide>
    ))
  }
</swiper-container>

<script is:inline>
  const root = document.currentScript.closest('swiper-container')
  if (root) {
    Object.assign(root, {
      breakpoints: {
        640: { slidesPerView: 1 },
        768: { slidesPerView: 2 },
        1024: { slidesPerView: 3 },
      },
      autoplay: {
        delay: 3000,
        disableOnInteraction: false,
        pauseOnMouseEnter: true,
      },
    })

    // ako korisnik želi isključiti autoplay, poštuj to
    if (!_autoplay) {
      root.autoplay = false
    }

    root.initialize?.()
  }
</script>
