---
import { themeConfig } from '~/.config'
const configTheme = themeConfig.appearance.theme ?? 'system' // 'light' | 'dark' | 'system'
---

<script is:inline define:vars={{ configTheme }}>
  // Globalna funkcija – koristi je i toggle
  window.applyTheme = function (theme) {
    if (theme === 'system') {
      const mql = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)')
      const prefers = !!(mql && mql.matches)
      document.documentElement.classList.toggle('dark', prefers)
      return
    }
    document.documentElement.classList.toggle('dark', theme === 'dark')
  }
  ;(function initTheme() {
    // prettier-ignore
    try {
      // 1) uzmi korisnički izbor ili konfiguraciju
      const saved = localStorage.getItem('theme') || configTheme;
      window.applyTheme(saved);

      // 2) ako je 'system', prati promjene OS-a
      const mq = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)');
      const onChange = function () {
      const mode = localStorage.getItem('theme') || configTheme;
      if (mode === 'system') {
        window.applyTheme('system');
      }
    };
      if (mq && typeof mq.addEventListener === 'function') {
        mq.addEventListener('change', onChange);
      }
      if (mq && typeof mq.addListener === 'function') {
        // stari Safari (deprecated, ali još prisutan)
        mq.addListener(onChange);
      }

      // 3) SWUP: nakon svake zamjene sadržaja ponovno primijeni trenutno stanje
      document.addEventListener('swup:contentReplaced', () => {
        const current = localStorage.getItem('theme') || configTheme;
        window.applyTheme(current);
      });
    }
    catch {
      /* silent */
    }
  })()
</script>
