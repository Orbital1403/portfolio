---
/* Follows the visitor's system setting until they choose a theme with the toggle. */
---

<script is:inline>
  window.applyTheme = function (theme) {
    const html = document.documentElement
    html.classList.toggle('dark', theme === 'dark')
    html.dataset.theme = theme
  }
  ;(function initTheme() {
    if (window.__portfolioThemeInitialized) {
      return
    }
    window.__portfolioThemeInitialized = true
    const media = window.matchMedia('(prefers-color-scheme: dark)')
    const chosen = () => {
      try {
        return localStorage.getItem('theme-choice')
      } catch {
        return null
      }
    }
    const current = () => chosen() || (media.matches ? 'dark' : 'light')
    window.applyTheme(current())
    document.addEventListener('astro:after-swap', () => window.applyTheme(current()))
    media.addEventListener('change', () => chosen() || window.applyTheme(current()))
  })()
</script>
