<button type="button" class="analytics-preferences" data-analytics-settings hidden>Analytics preferences</button>

<section class="analytics-consent" aria-labelledby="analytics-heading" data-analytics-banner hidden>
  <h2 id="analytics-heading">A small note on analytics</h2>
  <p>
    With your permission, Google Analytics uses cookies to help me understand visits and improve this portfolio.
    You can decline or change your choice at any time using Analytics preferences in the footer.
    <a href="https://policies.google.com/technologies/partner-sites" target="_blank" rel="noopener noreferrer">How Google uses data</a>.
  </p>
  <div class="analytics-actions">
    <button type="button" data-analytics-choice="denied">Decline analytics</button>
    <button type="button" data-analytics-choice="granted">Accept analytics</button>
  </div>
</section>

<script>
  const measurementId = 'G-FBSDVWHLPQ'
  const storageKey = 'portfolio:analytics-consent:v1'
  const lifetime = 180 * 24 * 60 * 60 * 1000
  const production = ['gordangrgic.com', 'www.gordangrgic.com'].includes(location.hostname)
  const analyticsWindow = window as typeof window & {
    dataLayer?: unknown[]
    gtag?: (...args: unknown[]) => void
    'ga-disable-G-FBSDVWHLPQ'?: boolean
  }
  let started = false
  let choice: 'granted' | 'denied' | null = null

  function readChoice(): typeof choice {
    try {
      const stored = JSON.parse(localStorage.getItem(storageKey) ?? 'null')
      if (stored && ['granted', 'denied'].includes(stored.choice)
        && typeof stored.at === 'number' && stored.at <= Date.now() && Date.now() - stored.at < lifetime) {
        return stored.choice
      }
    }
    catch { /* A blocked or unavailable store leaves analytics off by default. */ }
    return null
  }

  function startAnalytics() {
    if (!production || started || choice !== 'granted') return
    started = true
    analyticsWindow['ga-disable-G-FBSDVWHLPQ'] = false
    analyticsWindow.dataLayer = analyticsWindow.dataLayer || []
    analyticsWindow.gtag = function () {
      analyticsWindow.dataLayer!.push(arguments)
    }
    analyticsWindow.gtag('consent', 'default', {
      analytics_storage: 'denied',
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
    })
    analyticsWindow.gtag('consent', 'update', { analytics_storage: 'granted' })
    analyticsWindow.gtag('js', new Date())
    // GA4 Enhanced Measurement handles Astro's history navigation automatically.
    // Keep a single config call; manual page_view events would count visits twice.
    analyticsWindow.gtag('config', measurementId, {
      allow_google_signals: false,
      allow_ad_personalization_signals: false,
      cookie_expires: lifetime / 1000,
    })
    const script = document.createElement('script')
    script.async = true
    script.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`
    document.head.append(script)
  }

  function clearAnalyticsCookies() {
    for (const cookie of document.cookie.split(';')) {
      const name = cookie.split('=')[0].trim()
      if (!/^_ga(?:_|$)/.test(name)) continue
      for (const domain of ['', location.hostname, '.gordangrgic.com']) {
        document.cookie = `${name}=; Max-Age=0; Path=/; SameSite=Lax${domain ? `; Domain=${domain}` : ''}`
      }
    }
  }

  function init() {
    choice = readChoice()
    const settings = document.querySelector<HTMLButtonElement>('[data-analytics-settings]')
    const banner = document.querySelector<HTMLElement>('[data-analytics-banner]')
    if (settings) settings.hidden = !production
    if (banner) banner.hidden = !production || choice !== null
    if (choice === 'granted') startAnalytics()
  }

  document.addEventListener('click', (event) => {
    if (!production || !(event.target instanceof Element)) return
    const banner = document.querySelector<HTMLElement>('[data-analytics-banner]')
    if (event.target.closest('[data-analytics-settings]')) {
      if (banner) {
        banner.hidden = false
        banner.querySelector<HTMLButtonElement>('button')?.focus()
      }
      return
    }
    const selected = event.target.closest<HTMLButtonElement>('[data-analytics-choice]')?.dataset.analyticsChoice
    if (selected !== 'granted' && selected !== 'denied') return
    choice = selected
    try { localStorage.setItem(storageKey, JSON.stringify({ choice, at: Date.now() })) }
    catch { /* Honour the choice for this page even when storage is blocked. */ }
    if (banner) banner.hidden = true
    document.querySelector<HTMLButtonElement>('[data-analytics-settings]')?.focus()
    if (choice === 'granted') {
      startAnalytics()
    }
    else {
      analyticsWindow['ga-disable-G-FBSDVWHLPQ'] = true
      clearAnalyticsCookies()
      // Unload the library and its automatic event listeners on withdrawal.
      if (started) location.reload()
    }
  })
  window.addEventListener('storage', (event) => {
    if (event.key !== storageKey && event.key !== null) return
    if (started && readChoice() !== 'granted') {
      analyticsWindow['ga-disable-G-FBSDVWHLPQ'] = true
      clearAnalyticsCookies()
      location.reload()
    }
    else init()
  })
  init()
  document.addEventListener('astro:page-load', init)
</script>

<style>
  [hidden] { display: none !important; }
  .analytics-preferences {
    margin-top: 8px;
    font: inherit;
    font-size: 12px;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .analytics-consent {
    position: fixed;
    z-index: 1000;
    inset: auto 16px 16px auto;
    box-sizing: border-box;
    width: min(460px, calc(100vw - 32px));
    max-height: calc(100dvh - 32px);
    overflow-y: auto;
    padding: 20px;
    border: 1px solid currentColor;
    border-radius: 4px;
    background: var(--uno-colors-background, #f6f4ee);
    color: var(--uno-colors-primary, #24313b);
    box-shadow: 0 6px 30px #0003;
    text-align: left;
    text-shadow: none;
  }
  h2 { margin: 0 0 10px; font: 600 16px var(--body-font, sans-serif); }
  p { margin: 0; font-size: 14px; line-height: 1.6; }
  .analytics-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; }
  .analytics-actions button {
    flex: 1 1 150px;
    min-height: 44px;
    padding: 8px 12px;
    border: 1px solid currentColor;
    border-radius: 3px;
    font: inherit;
    font-size: 14px;
    cursor: pointer;
  }
  button:hover { text-decoration: underline; }
  button:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
</style>
