---
import Icon from '~/components/Icon.astro'
import growIcons from '~/assets/grgagrow-icons.svg?url&no-inline'

interface Props {
  icon: string
}
const { icon } = Astro.props
---

<summary class="disclosure-summary">
  <Icon sprite={growIcons} name={icon} class="disclosure-icon" />
  <span><slot /></span>
  <Icon name="right" class="disclosure-caret" />
</summary>

<style>
  .disclosure-summary {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr) 16px;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding-block: 8px;
    list-style: none;
    cursor: pointer;
    font: 600 14px/1.5 var(--note-font);
  }
  .disclosure-summary::-webkit-details-marker {
    display: none;
  }
  .disclosure-summary:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
  .disclosure-summary :global(.disclosure-icon) {
    width: 24px;
    height: 24px;
    stroke-width: 1.7;
    color: var(--grow-accent);
  }
  .disclosure-summary :global(.disclosure-caret) {
    width: 16px;
    height: 16px;
  }
  :global(details[open]) > .disclosure-summary :global(.disclosure-caret) {
    transform: rotate(90deg);
  }
</style>
