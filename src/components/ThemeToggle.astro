---
import Icon from '~/components/Icon.astro'

interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<button
  type="button"
  aria-label="Toggle theme"
  title="Toggle theme"
  class:list={['theme-toggle inline-flex items-center justify-center cursor-pointer', className]}
  onclick="(function(){
    const next = document.documentElement.classList.contains('dark') ? 'light' : 'dark';
    try { localStorage.setItem('theme-choice', next); } catch {}
    if (window.applyTheme) window.applyTheme(next);
  })()"
>
  <Icon name="sun" class="theme-sun" />
  <Icon name="moon" class="theme-moon" />
</button>

<style>
  .theme-toggle {
    transition:
      transform 0.25s ease,
      opacity 0.2s ease;
  }
  .theme-toggle:hover {
    transform: rotate(15deg) scale(1.05);
  }
  .theme-toggle:active {
    transform: scale(0.95);
    opacity: 0.85;
  }
</style>
